            self.done = True
            return
        front = c.x + c.w if d > 0 else c.x
        if self.x0 is None:
            if (front - self.go) * d > 0:
                self.x0 = front
            return
        c.vx *= 1.03
        if abs(c.vx) > 1.9 or (front - sc.W / 2) * d > sc.W / 2 - 3:
            y = int(round(c.y))
            sc.fx.append(Flash(sc.rnd, front, y + 1.5, 3, (0.6, 0.8, 1.0), 16))
            sc.fx.append(FireTrail(sc.rnd, front - d * 5, [y + 3, y + 4], d, abs(front - self.x0)))
            c.dead = self.done = True

    def over(self, put, t):
        c, r = self.c, self.rnd
        if self.x0 is None or c.dead or abs(c.vx) < 0.8:
            return
        col = rgb(0.6, 0.85, 1.0)
        for _ in range(4 + int(abs(c.vx) * 3)):
            put(int(c.x + r.uniform(0, c.w)), int(round(c.y + r.uniform(-0.6, c.h - 0.4))),
                r.choice("~-'`"), col)


# силуэт: каждая непустая клетка вырезается из диска луны
BIKE = [
    r"             @@",
    r"            @@@@    @@",
    r"            @@@@   @@@@",
    r"         @@  @@@@ @@@@@@",
    r"          @@@@@@@@@@@@@@",
    r"     @@@@@@   @@   @@@@@@",
    r"    @@    @@   @@ @@    @@",
    r"    @@    @@@@@@@@@@    @@",
    r"     @@@@@@        @@@@@@",
]


class Moonbike(Act):
    """Большая луна, и на её фоне силуэт велосипеда с пассажиром в корзинке."""
    need = (70, 16)

    def __init__(self, sc):
        r, W, H = sc.rnd, sc.W, sc.H
        self.R = R = max(5, min(10, H // 3))
        self.cx = W * r.uniform(0.35, 0.65)
        self.cy = r.randint(R + 1, max(R + 1, H - R - 2))
        n, rr = Noise(r), R + 0.35
        self.cells = []
        for dy in range(-R - 1, R + 2):
            for dx in range(-2 * R - 2, 2 * R + 3):
                nx, ny = dx / (2 * rr), dy / rr
                d2 = nx * nx + ny * ny
                if d2 > 1:
                    continue
                g = 0.7 + 0.3 * math.sqrt(1 - d2)
                if n.fbm(dx * 0.09, dy * 0.18, 3.3, 3) > 0.56:      # моря
                    g *= 0.8
                self.cells.append((dx, dy, "@" if g > 0.84 else "%" if g > 0.7 else "#", g))
        self.x0 = self.bx = self.cx - 2 * R - 30
        self.span = 4 * R + 32
        self.age, self.fade = 0, 0.0

    def _by(self):
        k = (self.bx - self.x0) / self.span
        return self.cy - 4 - 2.5 * math.sin(k * math.pi)

    def step(self, sc):
        self.age += 1
        if self.bx < self.x0 + self.span:
            self.fade = min(1.0, self.fade + 0.03)
            if self.age > 35:
                self.bx += 0.4
        else:
            self.fade -= 0.03
            if self.fade <= 0:
                self.done = True

    def under(self, put, t):
        f, cx, cy = self.fade, int(round(self.cx)), self.cy
        for dx, dy, ch, g in self.cells:
            b = g * f
            put(cx + dx, cy + dy, ch, rgb(b, b * 0.95, b * 0.78))

    def over(self, put, t):
        if self.age <= 35:
            return
        x0, y0 = int(round(self.bx)), int(round(self._by()))
        rr = self.R + 0.35
        for j, line in enumerate(BIKE):
            for i, ch in enumerate(line):
                if ch == " ":
                    continue
                x, y = x0 + i, y0 + j
                nx, ny = (x - self.cx) / (2 * rr), (y - self.cy) / rr
                if nx * nx + ny * ny <= 1:
                    put(x, y, " ", BLACK)


class HoleFeed(Act):
    """Подкидывает чёрной дыре пару кораблей и камней на близкий пролёт."""

    def __init__(self, sc, hole):
        self.h, self.n, self.wait = hole, sc.rnd.randint(2, 3), 0

    def step(self, sc):
        h, r = self.h, sc.rnd
        if h not in sc.holes or self.n <= 0:
            self.done = True
            return
        if h.x > sc.W - h.R * 4:
            return
        self.wait -= 1
        if self.wait > 0:
            return
        s = sc.spawn(r.choice(("rocket", "fighter", "probe", "rock1", "rock3", "satellite")), d=1)
        s.vy = 0.0
        if s.rock:
            s.vx = r.uniform(0.25, 0.4)
        off = r.choice((-1, 1)) * r.uniform(2.0, 3.0) * h.R
        s.y = float(_clamp(h.y + off - s.h / 2, 0, sc.H - s.h))
        self.n -= 1
        self.wait = r.randint(140, 260)


ACTS = {"chase": Chase, "docking": Docking, "beamup": Beamup, "crash": Crash, "battle": Battle,
        "impact": Impact, "wormhole": Wormhole, "trench": Trench, "hitchhike": Hitchhike,
        "timecar": Timecar, "moonbike": Moonbike}


# ───────────────────────────── сцена ────────────────────────────

EVENTS = ["station", "dogfight", "formation", "asteroids", "blackhole", "supernova",
          "whale", "jellies", "destroyer", "abduction",
          "chase", "docking", "beamup", "crash", "battle", "impact", "wormhole", "trench",
          "hitchhike", "timecar", "moonbike", "petunias", "monolith"]
NEBULAE = [((0.75, 0.15, 0.7), (0.15, 0.3, 0.9)), ((0.1, 0.6, 0.65), (0.5, 0.2, 0.8)),
           ((0.85, 0.3, 0.2), (0.7, 0.15, 0.6)), ((0.2, 0.35, 0.9), (0.15, 0.7, 0.55))]
TINTS = [(1, 1, 1), (1, 1, 1), (0.72, 0.82, 1.0), (1.0, 0.95, 0.72), (1.0, 0.76, 0.62)]


class Scene:
    def __init__(self, W, H, seed=None, ships=True):
        self.rnd = random.Random(seed)
        self.ships_on = ships
        self.t = 0
        self.build(W, H)

    def build(self, W, H):
        r = self.rnd
        self.W, self.H = W, H
        # фон: туманность + галактика
        self.base_ch = [[" "] * W for _ in range(H)]
        self.base_co = [[BLACK] * W for _ in range(H)]
        n = Noise(r)
        ca, cb = r.choice(NEBULAE)
        z = r.uniform(0, 100)
        for y in range(H):
            rc, ro = self.base_ch[y], self.base_co[y]
            for x in range(W):
                d = n.fbm(x * 0.022, y * 0.05, z, 4) - 0.57
                if d <= 0:
                    continue
                k = min(1.0, d * 5.5)
                if k < 0.3 and r.random() > 0.25 + k * 2:
                    continue
                c = mix(ca, cb, (n.fbm(x * 0.012 + 40, y * 0.03, z + 9, 2) - 0.3) * 2.5)
                b = 0.3 + 0.6 * k
                rc[x] = "." if k < 0.3 else ":" if k < 0.6 else ";" if k < 0.88 else "%"
                ro[x] = rgb(c[0] * b, c[1] * b, c[2] * b)
        if W >= 60 and H >= 16:
            self._galaxy(r.randint(W // 6, W * 5 // 6), r.randint(H // 5, H * 4 // 5),
                         r.uniform(9, 16))
        # звёзды: [x, y, слой, фаза, частота, оттенок, гигант]
        self.stars = []
        for _ in range(max(20, W * H // 26)):
            q = r.random()
            layer = 0 if q < 0.62 else 1 if q < 0.92 else 2
            self.stars.append([r.uniform(0, W), r.randint(0, H - 1), layer, r.uniform(0, TAU),
                               r.uniform(0.03, 0.16), r.choice(TINTS),
                               layer == 2 and r.random() < 0.3])
        self.giants = [s for s in self.stars if s[6]]
        self.planets, self.ships, self.meteors, self.comets = [], [], [], []
        self.fx, self.bolts, self.holes, self.station, self.deck = [], [], [], None, []
        self.acts, self.debris, self.tug_in = [], [], None
        self.event_in = r.randint(160, 320)
        big = max(3, min(H // 3, W // 9, 13))
        if H >= 12:
            R = r.randint(max(3, big - 3), big)
            self.planets.append(Planet(r, R, r.uniform(W * 0.55, W * 0.82), self._py(R)))
            if W >= 100:
                R2 = r.randint(2, max(2, big // 3))
                self.planets.append(Planet(r, R2, r.uniform(W * 0.1, W * 0.35), self._py(R2)))
        self.ship_in = r.randint(20, 70)
        self.comet_in = r.randint(150, 500)
        self.planet_in = r.randint(300, 900)

    def _py(self, R):
        lo, hi = R // 2 + 1, self.H - R // 2 - 2
        return self.rnd.randint(lo, hi) if hi > lo else self.H // 2

    def _galaxy(self, gx, gy, R):
        r, W, H = self.rnd, self.W, self.H
        rot, tilt = r.uniform(0, TAU), r.uniform(0.35, 0.8)
        ca, sa = math.cos(rot), math.sin(rot)
        tint = r.choice([(0.7, 0.8, 1.0), (1.0, 0.85, 0.75), (0.85, 0.75, 1.0)])

        def dot(px, py, ch, b):
            x = int(round(gx + (px * ca - py * sa * tilt) * 2))
            y = int(round(gy + (px * sa + py * ca * tilt)))
            if 0 <= x < W and 0 <= y < H:
                self.base_ch[y][x] = ch
                self.base_co[y][x] = rgb(tint[0] * b, tint[1] * b, tint[2] * b)
        for arm in range(2):
            for i in range(int(R * 16)):
                t = r.random() ** 0.8
                a = arm * math.pi + t * 4.6 + r.gauss(0, 0.22)
                rad = t * R / 2 + r.gauss(0, 0.25)
                b = 0.85 - 0.6 * t
                dot(math.cos(a) * rad, math.sin(a) * rad, "." if t > 0.35 else ":", b)
        for i in range(int(R * 3)):
            a, rad = r.uniform(0, TAU), abs(r.gauss(0, R * 0.05))
            dot(math.cos(a) * rad, math.sin(a) * rad, "*" if rad < 0.5 else "+", 1.0)
        dot(0, 0, "@", 1.2)

    def step(self):
        r, W, H = self.rnd, self.W, self.H
        self.t += 1
        for s in self.stars:
            s[0] -= (0.012, 0.035, 0.08)[s[2]]
            if s[0] < 0:
                s[0] += W
                s[1] = r.randint(0, H - 1)
        for p in self.planets:
            p.step()
        self.planets = [p for p in self.planets if p.x > -p.ext - 2]
        self.planet_in -= 1
        if self.planet_in <= 0 and len(self.planets) < 2 and H >= 12:
            big = max(3, min(H // 3, W // 9, 13))
            R = r.randint(2, big)
            p = Planet(r, R, 0, self._py(R))
            p.x = W + p.ext + 1
            self.planets.append(p)
            self.planet_in = r.randint(900, 2200)
        t = self.t
        for s in self.ships:
            s.step()
            if s.gun and t % s.gun == 0 and 0 < s.x < W:
                self.fire(s)
            if s.jump is not None and (s.x - s.jump) * s.dir > 0:
                self.fx.append(Streak(s.x + (0 if s.dir > 0 else s.w), s.y + 1, s.dir,
                                      max(1, s.h - 2)))
                s.dead = True
        for b in self.bolts:
            b[0] += b[2]
            b[3] -= 1
            for s in self.ships:
                if s.team and s.team != b[5] and not s.dead and s.x <= b[0] <= s.x + s.w and \
                        s.y <= b[1] < s.y + s.h and r.random() < b[6]:
                    b[3] = 0
                    s.hp -= 1
                    if s.hp <= 0:
                        self.wreck(s)
                    else:
                        self.fx.append(Flash(r, b[0], b[1], 1, (1.0, 0.8, 0.4), 8))
                    break
        self.bolts = [b for b in self.bolts if b[3] > 0]
        self.interact()
        for group in (self.meteors, self.comets, self.fx, self.holes):
            for e in group:
                e.step()
        self.fx = [e for e in self.fx if not e.done]
        self.holes = [h for h in self.holes if h.x > -h.ext - 2]
        if self.station:
            self.station.step(self)
            if self.station and self.station.done:
                self.station = None
        for a in self.acts:
            a.step(self)
        self.acts = [a for a in self.acts if not a.done]
        keep = []
        for s in self.ships:
            if s.gone(W, H):
                s.dead = True               # сценки узнают об уходе корабля по этому флагу
            else:
                keep.append(s)
        self.ships = keep
        self.comets = [c for c in self.comets if not c.gone(W)]
        self.meteors = [m for m in self.meteors if m.age < m.life]
        if self.debris:
            for p in self.debris:
                p[0] += p[2]
                p[1] += p[3]
                p[6] -= 1
            self.debris = [p for p in self.debris if p[6] > 0 and -4 < p[0] < W + 4 and -3 < p[1] < H + 3]
            if self.tug_in is not None and self.ships_on:
                self.tug_in -= 1
                if self.tug_in <= 0:
                    self.tug_in = None
                    if not any(isinstance(a, Salvage) for a in self.acts) and H >= 4:
                        self.acts.append(Salvage(self))
        if self.ships_on:
            self.event_in -= 1
            if self.event_in <= 0:
                if self.busy():
                    self.event_in = 60
                else:
                    self.event()
                    self.event_in = r.randint(300, 560)
        if r.random() < 0.012:
            self.meteors.append(Meteor(r, W, H))
        if self.ships_on:
            self.ship_in -= 1
            if self.ship_in <= 0 and len(self.ships) < 4:
                name = r.choice(SHIP_WEIGHTS)
                if H >= len(SPRITES[name][0]) + 2:
                    self.ships.append(Ship(r, name, W, H))
                self.ship_in = r.randint(50, 220)
        self.comet_in -= 1
        if self.comet_in <= 0:
            self.comets.append(Comet(r, W, H))
            self.comet_in = r.randint(700, 1800)

    def destroy(self, planet):
        self.planets.remove(planet)
        cols = [planet.tex[j][i][:3] for j in range(4, TH, 8) for i in range(0, TW, 12)]
        self.fx.append(Explosion(self.rnd, planet.x, planet.y, planet.R, cols))
        self.planet_in = min(self.planet_in, 260)

    # ─── помощники для сценок ───

    def spawn(self, name, d=None, x=None, y=None, vx=None):
        s = Ship(self.rnd, name, self.W, self.H, d=d, x=x, y=y, vx=vx)
        s.jump = None
        self.ships.append(s)
        return s

    def fire(self, s, col=(0.3, 1.0, 0.3), p=0.3):
        self.bolts.append([s.x + (s.w if s.dir > 0 else -2), int(round(s.y)) + s.h // 2,
                           s.dir * 2.4, 45, rgb(*col), s.team, p])

    def wreck(self, s, big=1):
        """Корабль взрывается; часть его символов остаётся дрейфовать обломками."""
        r = self.rnd
        s.dead = True
        cx, cy = s.cx, s.cy
        self.fx.append(Explosion(r, cx, cy, big, [(1, 0.8, 0.3), (1, 0.4, 0.1), (0.8, 0.8, 0.8)]))
        cells = [(i, j, ch) for j, line in enumerate(s.lines) for i, ch in enumerate(line)
                 if ch not in " _"]
        room = 60 - len(self.debris)
        for i, j, ch in r.sample(cells, max(0, min(len(cells), room, r.randint(6, 12)))):
            x, y = s.x + i, s.y + j
            self.debris.append([x, y, (x - cx) * 0.012 + r.uniform(-0.04, 0.04),
                                (y - cy) * 0.02 + r.uniform(-0.02, 0.02), ch,
                                s.cmap.get(ch, s.base), r.randint(1500, 2600)])
        if self.tug_in is None:
            self.tug_in = r.randint(120, 260)

    def busy(self):
        return len(self.acts) + (self.station is not None) >= 2 or len(self.ships) >= 10

    def interact(self):
        """Взаимодействия, которые работают и для обычных кораблей, не только в сценках."""
        r, W, H, t = self.rnd, self.W, self.H, self.t
        ships = self.ships
        for h in self.holes:                          # гравитация чёрной дыры
            reach = (h.R * 5.0) ** 2
            for s in ships:
                if s.dead or s.name in HEAVY:
                    continue
                dx, dy = (h.x - s.cx) / 2, h.y - s.cy
                d2 = dx * dx + dy * dy
                if d2 > reach:
                    continue
                d = math.sqrt(d2) + 1e-6
                if d < h.R * 1.1:
                    self.fx.append(Spaghetti(r, s, h))
                    s.dead, h.flare = True, 25
                    continue
                a = 0.9 / max(d2, 1.0)
                s.vx += a * dx / d * 2
                s.vy += a * dy / d
            for p in self.debris:
                dx, dy = (h.x - p[0]) / 2, h.y - p[1]
                d2 = dx * dx + dy * dy
                if d2 < reach:
                    d = math.sqrt(d2) + 1e-6
                    if d < h.R * 0.9:
                        p[6] = 0
                    a = 0.9 / max(d2, 1.0)
                    p[2] += a * dx / d * 2 - dy / d * 0.01
                    p[3] += a * dy / d + dx / d * 0.005
        rocks = [s for s in ships if s.rock and not s.dead]
        if rocks:                                     # астероид против корабля
            for s in ships:
                if s.dead or s.name not in FRAGILE:
                    continue
                for k in rocks:
                    kx, ky = k.cx, k.cy
                    if s.x + 1 <= kx <= s.x + s.w - 1 and s.y <= ky <= s.y + s.h - 0.5 and \
                            (k.must or r.random() < 0.2):
                        self.wreck(s)
                        if k.w < 5:
                            k.dead = True
                        break
        for w in ships:
            nm = w.name
            if nm == "whale" and not w.dead:          # кит глотает мелочь
                wy = w.y + math.sin(t * 0.07 + w.ph) * w.bob
                mx = w.x + w.w - 3 if w.dir > 0 else w.x + 3
                for s in ships:
                    if s is not w and not s.dead and (s.name == "probe" or s.name in ("rock3", "rock4")) \
                            and abs(s.cx - mx) < 3.5 and abs(s.cy - (wy + 2)) < 1.6:
                        s.dead = True
                        bx = w.x + (w.w * 0.75 if w.dir > 0 else w.w * 0.25)
                        for i, ch in enumerate("oO"):
                            self.fx.append(Text(bx - w.x, wy - w.y - 1, ch, (0.6, 0.9, 1.0), 40,
                                                -0.08, i * 14, anchor=w))
            elif nm == "jelly" and not w.dead:        # медузы разлетаются от кораблей
                for s in ships:
                    if s.name != "jelly" and abs(s.vx) > 0.15 and \
                            abs(s.cx - w.cx) < (s.w + w.w) / 2 + 4 and abs(s.cy - w.cy) < (s.h + w.h) / 2 + 2:
                        w.vx += (0.12 if w.cx > s.cx else -0.12)
                        w.vy += (0.05 if w.cy > s.cy else -0.05)
                        break
            elif nm == "astronaut" and not w.wave and not w.hidden and t % 10 == 0:
                for s in ships:
                    if s is not w and not s.rock and abs(s.cx - w.cx) < 26 and abs(s.cy - w.cy) < 9 \
                            and abs(s.vx) > 0.2:
                        w.wave = 60
                        break
            elif nm == "monolith" and not w.dead:     # выравнивание
                if w.cool > 0:
                    w.cool -= 1
                    continue
                mx = w.cx
                if not 0 < mx < W:
                    continue
                for p in self.planets:
                    if abs(mx - p.x) < 0.5:
                        self.fx.append(Align(w, p.y, p.R + 0.5))
                        p.flash, w.cool = max(p.flash, 0.3), 400
                        break
                else:
                    for s in self.giants:
                        if abs(mx - s[0]) < 0.4 and abs(s[1] - w.cy) > w.h:
                            self.fx.append(Align(w, s[1], 0))
                            w.cool = 400
                            break

    def event(self, name=None):
        """Именованное событие или следующее из колоды (без повторов, пока не сыграны все)."""
        if name:
            return self._event(name)
        for _ in range(len(EVENTS)):
            if not self.deck:
                self.deck = EVENTS[:]
                self.rnd.shuffle(self.deck)
            if self._event(self.deck.pop()):
                return True
        return False

    def _event(self, name):
        r, W, H = self.rnd, self.W, self.H
        d = r.choice((1, -1))
        add = self.ships.append
        act = ACTS.get(name)
        if act is not None:
            if not act.fits(self):
                return False
            a = act(self)
            if a.done:
                return False
            self.acts.append(a)
            return True
        if name == "station":
            if self.station or H < 20 or W < 80:
                return False
            cands = [p for p in self.planets if W * 0.12 < p.x < W * 0.88]
            if cands:
                target = max(cands, key=lambda p: p.R)
            else:                                     # планеты нет: целится в корабль
                ships = [s for s in self.ships if not s.dead and s.name in TARGETS and
                         W * 0.25 < s.cx < W * 0.75]
                target = r.choice(ships) if ships else self.spawn(r.choice(("freighter", "destroyer")))
                target.jump = None
            self.station = Station(r, W, H, target)
        elif name == "dogfight":
            prey = Ship(r, "fighter", W, H, d=d, vx=d * 0.8)
            prey.team, prey.jump = 1, None
            add(prey)
            for k, dy in ((1, 3), (2, -3)):
                c = Ship(r, "ion", W, H, d=d, x=prey.x - d * (12 * k + 8), y=prey.y + dy,
                         vx=prey.vx * 1.04)
                c.gun, c.team = r.randint(9, 14), 2
                add(c)
        elif name == "formation":
            lead = Ship(r, r.choice(("ion", "fighter")), W, H, d=d)
            lead.jump = None
            add(lead)
            for k in (1, 2):
                for sg in (1, -1):
                    add(Ship(r, lead.name, W, H, d=d, x=lead.x - d * 9 * k,
                             y=lead.y + sg * 3 * k, vx=lead.vx))
        elif name == "asteroids":
            for _ in range(r.randint(9, 16)):
                s = Ship(r, r.choice(ROCKS), W, H, d=d)
                s.x -= d * r.uniform(0, 70)
                add(s)
        elif name == "blackhole":
            if self.holes or H < 20:
                return False
            h = BlackHole(r, W, H)
            self.holes.append(h)
            if W >= 70:
                self.acts.append(HoleFeed(self, h))
        elif name == "supernova":
            self.fx.append(Explosion(r, r.randint(8, max(9, W - 8)), r.randint(4, max(5, H - 4)), 2,
                                     [(1, 1, 1), (0.6, 0.8, 1), (1, 0.7, 0.9), (1, 0.9, 0.6)],
                                     fuse=45))
        elif name == "jellies":
            for _ in range(r.randint(3, 6)):
                add(Ship(r, "jelly", W, H))
        elif name == "whale":
            if H < 7:
                return False
            w = Ship(r, "whale", W, H, d=d)
            add(w)
            if r.random() < 0.5 and W >= 70:           # навстречу летит зонд: кит его глотает
                w.bob = 0.4
                p = self.spawn("probe", d=-d, vx=-d * 0.4)
                p.vy, p.y = 0.0, w.y + 1
        elif name == "petunias":                       # кит и горшок с петуниями падают сверху
            if H < 14:
                return False
            w = self.spawn("whale", d=d, x=r.uniform(W * 0.15, max(W * 0.15, W * 0.75 - 34)), y=-5,
                           vx=d * 0.03)
            w.vy, w.bob = 0.14, 0.0
            p = self.spawn("petunias", x=w.x + (w.w + 5 if r.random() < 0.5 else -12), y=-3, vx=w.vx)
            p.vy = 0.16
            self.fx.append(Text(w.w * (0.7 if d > 0 else 0.3), -1, "?", (1.0, 1.0, 0.7), 60, -0.04,
                                90, anchor=w))
        elif name == "monolith":                       # проходит над или под планетой
            if H < 12:
                return False
            m = self.spawn("monolith", d=1)
            m.vy = 0.0
            ps = [p for p in self.planets if p.x > W * 0.3]
            if ps:
                p = max(ps, key=lambda p: p.R)
                up, dn = p.y - p.R - m.h - 1, H - (p.y + p.R + 2) - m.h
                if max(up, dn) >= 0:
                    m.y = float(r.randint(0, int(up)) if up >= dn else
                                r.randint(int(p.y + p.R + 2), int(p.y + p.R + 2 + dn)))
        elif name in SPRITES and H >= len(SPRITES[name][0]) + 2:
            add(Ship(r, name, W, H))
        else:
            return False
        return True

    def compose(self):
        W, H, t = self.W, self.H, self.t
        ch = [row[:] for row in self.base_ch]
        co = [row[:] for row in self.base_co]

        def put(x, y, c, col):
            if 0 <= x < W and 0 <= y < H:
                ch[y][x] = c
                co[y][x] = col
        sin = math.sin
        mons = [(s.cx, s.cy) for s in self.ships if s.name == "monolith" and not s.hidden]
        for x, y, layer, ph, fr, tint, giant in self.stars:
            x = int(x)
            if x >= W:
                continue
            tw = 0.5 + 0.5 * sin(t * fr + ph)
            if mons:                                  # у монолита звёзды ярче
                for mx, my in mons:
                    if abs(x - mx) < 22 and abs(y - my) < 10:
                        tw = 0.6 + 0.4 * tw
                        layer = layer + 1 if layer < 2 else 2
                        break
            if layer == 0:
                b, c = 0.22 + 0.3 * tw, "."
            elif layer == 1:
                b = 0.4 + 0.45 * tw
                c = "." if tw < 0.45 else "·" if tw < 0.8 else "+"
            else:
                b = 0.6 + 0.4 * tw
                c = "+" if tw < 0.35 else "*" if tw < 0.75 else "✦"
                if giant and tw > 0.8:
                    f = rgb(tint[0] * 0.4, tint[1] * 0.4, tint[2] * 0.4)
                    put(x - 1, y, "-", f)
                    put(x + 1, y, "-", f)
                    put(x, y - 1, "|", f)
                    put(x, y + 1, "|", f)
            ch[y][x] = c
            co[y][x] = rgb(tint[0] * b, tint[1] * b, tint[2] * b)
        for m in self.meteors:
            m.draw(put)
        for c in self.comets:
            c.draw(put)
        for h in self.holes:
            h.draw(put, t)
        for p in sorted(self.planets, key=lambda p: p.R):
            p.draw(put)
        if self.station:
            self.station.draw(put, t)
        for a in self.acts:
            a.under(put, t)
        for p in self.debris:
            put(int(p[0]), int(p[1]), p[4] if p[6] > 60 or t % 2 else ".", p[5])
        for s in self.ships:
            s.draw(put, t)
        for b in self.bolts:
            put(int(b[0]), b[1], "-", b[4])
            put(int(b[0]) + 1, b[1], "-", b[4])
        for e in self.fx:
            e.draw(put)
        for a in self.acts:
            a.over(put, t)
        return ch, co


# ───────────────────────────── вывод ────────────────────────────

def snapshot(args):
    size = shutil.get_terminal_size((100, 32))
    W, H = args.width or size.columns, args.height or size.lines - 1
    sc = Scene(W, H, args.seed, not args.calm)
    for i in range(args.snapshot):
        if args.event and i == 5:
            sc.event(args.event)
        sc.step()
    ch, co = sc.compose()
    out = []
    for y in range(H):
        last, row = None, []
        for x in range(W):
            if co[y][x] != last:
                last = co[y][x]
                row.append("\x1b[38;5;%dm" % last)
            row.append(ch[y][x])
        out.append("\x1b[48;5;16m" + "".join(row) + "\x1b[0m")
    sys.stdout.write("\n".join(out) + "\n")


def run(stdscr, args):
    import curses
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    stdscr.leaveok(True)
    stdscr.nodelay(True)
    curses.start_color()
    try:
        curses.use_default_colors()
    except curses.error:
        pass
    full = curses.COLORS >= 256 and curses.COLOR_PAIRS >= 256
    attrs = [0] * 256
    if full:
        bg = -1 if args.transparent else BLACK
        for i in range(1, 256):
            curses.init_pair(i, i, bg)
            attrs[i] = curses.color_pair(i)
    else:  # 8 цветов: грубое приближение
        basic = [curses.COLOR_BLACK, curses.COLOR_RED, curses.COLOR_GREEN, curses.COLOR_YELLOW,
                 curses.COLOR_BLUE, curses.COLOR_MAGENTA, curses.COLOR_CYAN, curses.COLOR_WHITE]
        for i in range(1, 8):
            curses.init_pair(i, basic[i], -1 if args.transparent else curses.COLOR_BLACK)
        for i in range(16, 256):
            if i >= 232:
                v = 8 + 10 * (i - 232)
                r = g = b = v
            else:
                k = i - 16
                r, g, b = _CUBE[k // 36], _CUBE[k // 6 % 6], _CUBE[k % 6]
            m = max(r, g, b)
            if m < 60:
                attrs[i] = curses.color_pair(7) | curses.A_DIM
                continue
            bits = (r > m * 0.6) | ((g > m * 0.6) << 1) | ((b > m * 0.6) << 2)
            attrs[i] = curses.color_pair(bits or 7) | (curses.A_BOLD if m > 200 else 0)
    stdscr.bkgd(" ", attrs[BLACK])

    def new_scene(seed=None):
        H, W = stdscr.getmaxyx()
        stdscr.clear()  # полная перерисовка: после смены размера на экране остаётся мусор
        return Scene(max(W, 10), max(H, 4), seed, not args.calm), None

    sc, prev = new_scene(args.seed)
    delay = 1.0 / args.fps
    paused = False
    nxt = time.monotonic()
    while True:
        k = stdscr.getch()
        while k != -1:
            if k in (ord("q"), ord("Q"), 27):
                return
            if k in (ord("p"), ord("P"), ord(" ")):
                paused = not paused
            elif k in (ord("r"), ord("R")):
                sc, prev = new_scene()
            elif k in (ord("e"), ord("E")):
                sc.event()
            elif k in (ord("c"), ord("C")):
                sc.ships_on = not sc.ships_on
            elif k == curses.KEY_RESIZE:
                curses.update_lines_cols()
                sc, prev = new_scene()
            k = stdscr.getch()
        if not paused:
            sc.step()
        ch, co = sc.compose()
        H, W = sc.H, sc.W
        for y in range(H):
            rc, ro = ch[y], co[y]
            if prev and prev[0][y] == rc and prev[1][y] == ro:
                continue
            lim = W - 1 if y == H - 1 else W
            x = 0
            try:
                while x < lim:
                    c = ro[x]
                    e = x + 1
                    while e < lim and ro[e] == c:
                        e += 1
                    stdscr.addstr(y, x, "".join(rc[x:e]), attrs[c])
                    x = e
            except curses.error:
                pass
        prev = (ch, co)
        stdscr.refresh()
        sys.stdout.write("\x1b[?25l")  # некоторые терминалы игнорируют curs_set
        sys.stdout.flush()
        nxt += delay
        pause = nxt - time.monotonic()
        if pause > 0:
            time.sleep(pause)
        else:
            nxt = time.monotonic()


def main():
    ap = argparse.ArgumentParser(
        prog="spacii", description="Космос в терминале. Клавиши: q выход, p пауза, "
        "r новая вселенная, c корабли вкл/выкл, e событие.")
    ap.add_argument("-t", "--transparent", action="store_true",
                    help="не заливать фон чёрным (для прозрачных терминалов)")
    ap.add_argument("-c", "--calm", action="store_true", help="без кораблей, только космос")
    ap.add_argument("-f", "--fps", type=int, default=20, help="кадров в секунду (по умолчанию 20)")
    ap.add_argument("-s", "--seed", type=int, help="зерно: одна и та же вселенная каждый раз")
    ap.add_argument("--snapshot", type=int, metavar="N",
                    help="напечатать один кадр после N шагов и выйти")
    ap.add_argument("--event", help=argparse.SUPPRESS)
    ap.add_argument("--width", type=int, help=argparse.SUPPRESS)
    ap.add_argument("--height", type=int, help=argparse.SUPPRESS)
    ap.add_argument("-v", "--version", action="version", version="spacii " + VERSION)
    args = ap.parse_args()
    args.fps = max(1, min(60, args.fps))
    if args.snapshot is not None:
        return snapshot(args)
    if not sys.stdout.isatty():
        sys.exit("spacii: нужен терминал (или --snapshot N)")
    import curses
    import locale
    locale.setlocale(locale.LC_ALL, "")
    try:
        curses.wrapper(run, args)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
