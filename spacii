# ───────────────────────────── цвет ─────────────────────────────

_CUBE = (0, 95, 135, 175, 215, 255)
_qcache = {}
BLACK = 16


def rgb(r, g, b):
    """RGB 0..1 -> индекс палитры xterm-256."""
    key = (int(r * 48) if r < 1 else 48, int(g * 48) if g < 1 else 48,
           int(b * 48) if b < 1 else 48)
    c = _qcache.get(key)
    if c is not None:
        return c
    R, G, B = (max(0, k) * 255 / 48 for k in key)
    best, bd = BLACK, R * R + G * G + B * B
    idx = [min(range(6), key=lambda i: abs(_CUBE[i] - v)) for v in (R, G, B)]
    cr, cg, cb = (_CUBE[i] for i in idx)
    d = (R - cr) ** 2 + (G - cg) ** 2 + (B - cb) ** 2
    if d < bd:
        best, bd = 16 + 36 * idx[0] + 6 * idx[1] + idx[2], d
    gi = int(round(((R + G + B) / 3 - 8) / 10))
    gi = 0 if gi < 0 else 23 if gi > 23 else gi
    gv = 8 + 10 * gi
    d = (R - gv) ** 2 + (G - gv) ** 2 + (B - gv) ** 2
    if d < bd:
        best = 232 + gi
    _qcache[key] = best
    return best


def mix(a, b, t):
    t = 0.0 if t < 0 else 1.0 if t > 1 else t
    return (a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t,
            a[2] + (b[2] - a[2]) * t)


# ───────────────────────────── шум ──────────────────────────────

class Noise:
    def __init__(self, rnd):
        p = list(range(256))
        rnd.shuffle(p)
        self.p = p + p
        self.v = [rnd.random() for _ in range(256)]

    def n3(self, x, y, z):
        xi, yi, zi = math.floor(x), math.floor(y), math.floor(z)
        xf, yf, zf = x - xi, y - yi, z - zi
        u = xf * xf * (3 - 2 * xf)
        v = yf * yf * (3 - 2 * yf)
        w = zf * zf * (3 - 2 * zf)
        xi &= 255
        yi &= 255
        zi &= 255
        p, val = self.p, self.v
        a = p[xi] + yi
        b = p[xi + 1] + yi
        aa, ab, ba, bb = p[a] + zi, p[a + 1] + zi, p[b] + zi, p[b + 1] + zi
        x1 = val[p[aa]] + (val[p[ba]] - val[p[aa]]) * u
        x2 = val[p[ab]] + (val[p[bb]] - val[p[ab]]) * u
        y1 = x1 + (x2 - x1) * v
        x1 = val[p[aa + 1]] + (val[p[ba + 1]] - val[p[aa + 1]]) * u
        x2 = val[p[ab + 1]] + (val[p[bb + 1]] - val[p[ab + 1]]) * u
        y2 = x1 + (x2 - x1) * v
        return y1 + (y2 - y1) * w

    def fbm(self, x, y, z, octaves=3):
        s, amp, norm = 0.0, 1.0, 0.0
        for _ in range(octaves):
            s += self.n3(x, y, z) * amp
            norm += amp
            amp *= 0.5
            x, y, z = x * 2.03 + 11.7, y * 2.03 + 5.3, z * 2.03 + 3.1
        return s / norm


# ──────────────────────────── планеты ───────────────────────────

RAMP = " .,:;=+*#%@"
TW, TH = 96, 40
LIGHT = (-0.58, -0.46, 0.67)

GAS = [
    ((0.93, 0.78, 0.55), (0.72, 0.45, 0.25), (0.85, 0.3, 0.2)),   # юпитер
    ((0.95, 0.87, 0.6), (0.8, 0.68, 0.42), (1.0, 0.95, 0.8)),     # сатурн
    ((0.45, 0.7, 1.0), (0.2, 0.4, 0.9), (0.9, 0.95, 1.0)),        # нептун
    ((0.6, 0.95, 0.9), (0.35, 0.75, 0.8), (0.9, 1.0, 1.0)),       # уран
    ((0.9, 0.55, 0.85), (0.5, 0.3, 0.75), (1.0, 0.8, 0.95)),      # сиреневый
]


def _tex_gas(n, rnd):
    c1, c2, c3 = rnd.choice(GAS)
    bands = rnd.uniform(5, 9)
    sx, sy = rnd.uniform(0, TAU), rnd.uniform(-0.5, 0.5)
    spot = (math.cos(sy) * math.cos(sx), math.sin(sy), math.cos(sy) * math.sin(sx))

    def f(p, lat):
        t = math.sin(lat * bands + 3.0 * (n.fbm(p[0] * 2, p[1] * 2, p[2] * 2) - 0.5))
        c = mix(c1, c2, t * 0.5 + 0.5)
        d = n.fbm(p[0] * 7, p[1] * 14, p[2] * 7, 2)
        c = mix(c, (c[0] * 0.6, c[1] * 0.6, c[2] * 0.6), d * 0.7 - 0.2)
        ds = (p[0] - spot[0]) ** 2 + ((p[1] - spot[1]) * 2) ** 2 + (p[2] - spot[2]) ** 2
        if ds < 0.09:
            c = mix(c, c3, 1 - ds / 0.09)
        return c + (0.0,)
    return f, mix(c1, c2, 0.5)


def _tex_terra(n, rnd):
    sea = rnd.uniform(0.48, 0.56)

    def f(p, lat):
        h = n.fbm(p[0] * 1.7, p[1] * 1.7, p[2] * 1.7, 4)
        if h > sea:
            k = (h - sea) / 0.2
            c = mix((0.2, 0.6, 0.25), (0.6, 0.5, 0.3), k)
            if k > 0.85:
                c = mix(c, (0.95, 0.95, 0.95), (k - 0.85) * 5)
        else:
            c = mix((0.05, 0.15, 0.55), (0.15, 0.5, 0.9), h / sea)
        if abs(lat) > 1.12 + 0.3 * (n.n3(p[0] * 4, p[1] * 4, p[2] * 4) - 0.5):
            c = (0.95, 0.97, 1.0)
        cl = n.fbm(p[0] * 3 + 50, p[1] * 5, p[2] * 3, 3)
        if cl > 0.56:
            c = mix(c, (1, 1, 1), (cl - 0.56) * 9)
        return c + (0.0,)
    return f, (0.4, 0.65, 1.0)


def _tex_rock(n, rnd):
    tint = rnd.choice([(1.0, 1.0, 1.0), (1.0, 0.93, 0.85), (0.88, 0.93, 1.0)])

    def f(p, lat):
        g = 0.42 + 0.5 * n.fbm(p[0] * 2.5, p[1] * 2.5, p[2] * 2.5, 3)
        cr = n.fbm(p[0] * 8, p[1] * 8, p[2] * 8, 2)
        if cr < 0.36:
            g *= 0.55
        elif cr < 0.4:
            g *= 1.25
        return (g * tint[0], g * tint[1], g * tint[2], 0.0)
    return f, None


def _tex_mars(n, rnd):
    def f(p, lat):
        h = n.fbm(p[0] * 2.2, p[1] * 2.2, p[2] * 2.2, 4)
        c = mix((0.55, 0.2, 0.1), (1.0, 0.62, 0.35), (h - 0.3) * 2.5)
        if n.fbm(p[0] * 5 + 9, p[1] * 5, p[2] * 5, 2) < 0.38:
            c = mix(c, (0.3, 0.12, 0.1), 0.6)
        if abs(lat) > 1.25:
            c = (1.0, 0.95, 0.92)
        return c + (0.0,)
    return f, (0.9, 0.5, 0.3)


def _tex_ice(n, rnd):
    def f(p, lat):
        h = n.fbm(p[0] * 2.5, p[1] * 2.5, p[2] * 2.5, 3)
        c = mix((0.45, 0.75, 1.0), (0.97, 1.0, 1.0), (h - 0.3) * 2.5)
        if abs(n.fbm(p[0] * 6, p[1] * 6, p[2] * 6, 2) - 0.5) < 0.03:
            c = mix(c, (0.2, 0.4, 0.8), 0.7)
        return c + (0.0,)
    return f, (0.6, 0.85, 1.0)


def _tex_lava(n, rnd):
    def f(p, lat):
        h = n.fbm(p[0] * 3, p[1] * 3, p[2] * 3, 4)
        ridge = 1 - abs(h - 0.5) * 9
        c = mix((0.28, 0.13, 0.12), (0.4, 0.2, 0.15), h)
        if ridge > 0:
            return mix(c, (1.0, 0.55 + 0.4 * ridge, 0.1), ridge) + (0.25 + 0.6 * ridge,)
        return c + (0.0,)
    return f, (1.0, 0.35, 0.1)


KINDS = [(_tex_gas, 4), (_tex_terra, 3), (_tex_rock, 2), (_tex_mars, 2),
         (_tex_ice, 2), (_tex_lava, 1)]


class Planet:
    def __init__(self, rnd, R, x, y):
        self.R, self.x, self.y = R, float(x), float(y)
        self.rot = rnd.uniform(0, TW)
        self.spin = rnd.uniform(0.04, 0.12) * rnd.choice((1, 1, -1))
        self.speed = 0.012 + R * 0.004
        kinds = [k for k, w in KINDS for _ in range(w)]
        kind = rnd.choice(kinds)
        n = Noise(rnd)
        f, atmo = kind(n, rnd)
        self.gas = kind is _tex_gas
        tex = []
        for j in range(TH):
            lat = (j / (TH - 1) - 0.5) * math.pi
            cl, sl = math.cos(lat), math.sin(lat)
            tex.append([f((cl * math.cos(i / TW * TAU), sl, cl * math.sin(i / TW * TAU)), lat)
                        for i in range(TW)])
        self.tex = tex
        lx, ly, lz = LIGHT
        rr = R + 0.35
        self.cells, self.halo = [], []
        for dy in range(-R - 2, R + 3):
            for dx in range(-2 * R - 4, 2 * R + 5):
                nx, ny = dx / (2 * rr), dy / rr
                d2 = nx * nx + ny * ny
                if d2 <= 1:
                    nz = math.sqrt(1 - d2)
                    lum = max(0.0, nx * lx + ny * ly + nz * lz) ** 0.85
                    ti = int(math.atan2(nx, nz) / TAU * TW)
                    tj = int((math.asin(ny) / math.pi + 0.5) * (TH - 1))
                    self.cells.append((dx, dy, ti, tj, lum))
                elif atmo and d2 <= 1.3:
                    d = math.sqrt(d2)
                    l = (nx * lx + ny * ly) / d + 0.25
                    s = (1.3 - d2) / 0.3 * l
                    if s > 0.08:
                        self.halo.append((dx, dy, "." if s < 0.45 else ":",
                                          rgb(atmo[0] * s * 0.6, atmo[1] * s * 0.6, atmo[2] * s * 0.6)))
        # кольца
        self.ring_back, self.ring_front = [], []
        self.ext = 2 * R + 4
        if R >= 5 and (rnd.random() < (0.6 if self.gas else 0.15)):
            inner, outer = rnd.uniform(1.3, 1.5), rnd.uniform(1.9, 2.4)
            tilt, ang = rnd.uniform(0.2, 0.38), rnd.uniform(-0.35, 0.35)
            rc = rnd.choice([(0.9, 0.82, 0.62), (0.75, 0.8, 0.95), (0.95, 0.75, 0.6)])
            gap = rnd.uniform(0.45, 0.6)
            ca, sa = math.cos(ang), math.sin(ang)
            ex = int(2 * R * outer) + 2
            self.ext = ex
            for dy in range(-R - 3, R + 4):
                for dx in range(-ex, ex + 1):
                    px, py = dx / (2 * rr), dy / rr
                    qx, qy = px * ca + py * sa, -px * sa + py * ca
                    q = math.sqrt(qx * qx + (qy / tilt) ** 2)
                    if not inner < q < outer:
                        continue
                    k = (q - inner) / (outer - inner)
                    if abs(k - gap) < 0.05:
                        continue
                    inside = px * px + py * py < 1
                    back = qy < 0
                    if back and inside:
                        continue
                    # тень планеты на кольце
                    sh = 1.0
                    if back is False and qx > 0.25 and abs(qy) < 0.22 and not inside:
                        sh = 0.35
                    b = (0.55 + 0.45 * math.sin(k * 23)) * (0.9 if k < gap else 0.65) * sh
                    ch = "=" if b > 0.6 else "-" if b > 0.35 else "·"
                    item = (dx, dy, ch, rgb(rc[0] * b, rc[1] * b, rc[2] * b))
                    (self.ring_back if back else self.ring_front).append(item)
        # луны
        self.moons = []
        for _ in range(rnd.choice((0, 0, 1, 1, 2)) if R >= 4 else 0):
            g = rnd.uniform(0.6, 0.95)
            self.moons.append([rnd.uniform(1.5, 2.6), rnd.uniform(0.008, 0.03),
                               rnd.uniform(0, TAU), rnd.uniform(0.12, 0.3),
                               rgb(g, g, g * rnd.uniform(0.85, 1.0))])

    def step(self):
        self.x -= self.speed
        self.rot += self.spin
        for m in self.moons:
            m[2] += m[1]

    def draw(self, put):
        cx, cy, R = int(round(self.x)), int(round(self.y)), self.R
        for dx, dy, ch, c in self.ring_back:
            put(cx + dx, cy + dy, ch, c)
        front = []
        for a, _, th, tilt, c in self.moons:
            mx, my = math.cos(th) * a, math.sin(th) * a * tilt
            if math.sin(th) < 0:
                if mx * mx + my * my > 1.05:
                    put(cx + int(round(mx * 2 * R)), cy + int(round(my * R)), "o", c)
            else:
                front.append((cx + int(round(mx * 2 * R)), cy + int(round(my * R)), c))
        for dx, dy, ch, c in self.halo:
            put(cx + dx, cy + dy, ch, c)
        tex, shift, n = self.tex, int(self.rot), len(RAMP)
        for dx, dy, ti, tj, lum in self.cells:
            r, g, b, e = tex[tj][(ti + shift) % TW]
            l = lum * 1.12 + 0.015
            if e > l:
                l = e
            if l < 0.05:
                put(cx + dx, cy + dy, " ", BLACK)
                continue
            i = int(l * 0.9 * n)
            put(cx + dx, cy + dy, RAMP[i if i < n else n - 1], rgb(r * l, g * l, b * l))
        for dx, dy, ch, c in self.ring_front:
            put(cx + dx, cy + dy, ch, c)
        for mx, my, c in front:
            put(mx, my, "O", c)


