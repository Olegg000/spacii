STATION_BOOM = [(0.85, 0.85, 0.9), (0.6, 0.6, 0.65), (1.0, 0.7, 0.3), (1.0, 0.4, 0.1), (1, 1, 1)]


class Trench(Act):
    """Звено истребителей проходит над экваториальным жёлобом станции и пускает торпеду."""
    need = (90, 20)

    @classmethod
    def fits(cls, sc):
        return sc.station is None and sc.W >= cls.need[0] and sc.H >= cls.need[1]

    def __init__(self, sc):
        r = sc.rnd
        self.st = sc.station = Station(r, sc.W, sc.H, None, hold=True)
        self.fs, self.torp, self.state, self.age = [], None, "wait", 0
        self.win, self.lost = r.random() < 0.6, False

    def step(self, sc):
        r, st = sc.rnd, self.st
        self.age += 1
        p, d, s = st.p, st.side, self.state
        if sc.station is not st and s != "after":
            self.state = s = "after"
        if s == "wait":
            if st.state == "hold":
                cy = int(round(p.y))
                for k in range(3):
                    f = sc.spawn("fighter", d=d, vx=d * 0.85)
                    f.vy, f.y = 0.0, float(cy - 2)
                    f.x -= d * k * 16
                    self.fs.append(f)
                self.state, self.age = "run", 0
        elif s == "run":
            alive = [f for f in self.fs if not f.dead]
            for f in alive:
                if abs(f.cx - p.x) < 2 * st.R + 8 and r.random() < 0.15:
                    sc.fx.append(Flash(r, f.cx + r.uniform(-8, 8), f.cy + r.uniform(-2.5, 2.5), 1,
                                       (0.5, 1.0, 0.4), 8))
                    if not self.lost and f is not alive[0] and r.random() < 0.05:
                        self.lost = True
                        sc.wreck(f)
            tp = self.torp
            if tp is None:
                if not alive:
                    st.state, self.state = "out", "after"
                else:
                    lead = alive[0]
                    front = lead.x + lead.w if d > 0 else lead.x
                    if (front - (p.x - d * st.R)) * d > 0:
                        self.torp = [front, p.y, d * 1.3]
            else:
                tp[0] += tp[2]
                if (tp[0] - (p.x + d * st.R * 0.9)) * d > 0:
                    self.torp = None
                    if self.win:
                        self.state, self.age = "boom", 0
                    else:
                        sc.fx.append(Explosion(r, tp[0], tp[1], 1, STATION_BOOM[2:]))
                        self.state, self.age = "miss", 0
        elif s == "boom":
            if self.age % 5 == 0:
                sc.fx.append(Explosion(r, p.x + r.uniform(-1.6, 1.6) * st.R,
                                       p.y + r.uniform(-0.8, 0.8) * st.R, 1, STATION_BOOM[2:]))
            if self.age > 45:
                sc.fx.append(Explosion(r, p.x, p.y, st.R, STATION_BOOM))
                sc.station, self.state = None, "after"
        elif s == "miss":
            if self.age > 90:
                st.state, self.state = "out", "after"
        elif all(f.dead for f in self.fs) and sc.station is not st:
            self.done = True

    def over(self, put, t):
        tp = self.torp
        if tp:
            x, y = int(round(tp[0])), int(round(tp[1]))
            put(x, y, "o", rgb(1.0, 1.0, 0.8))
            for i in (1, 2):
                put(x - (1 if tp[2] > 0 else -1) * i, y, "-", rgb(1.0, 0.6 - 0.2 * i, 0.2))


