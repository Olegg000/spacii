class Ship:
    def __init__(self, rnd, name, W, H):
        art, base, cmap, flames, (v0, v1), mirror = SPRITES[name]
        self.name = name
        self.dir = rnd.choice((1, -1))
        width = max(len(l) for l in art)
        lines = [l.rstrip().ljust(width) for l in art]
        if self.dir < 0 and mirror:
            lines = [l[::-1].translate(MIRROR) for l in lines]
        self.lines, self.w, self.h = lines, width, len(lines)
        self.base = rgb(*base)
        self.cmap = {(k.translate(MIRROR) if self.dir < 0 and mirror else k): rgb(*v)
                     for k, v in cmap.items()}
        self.flames = flames
        self.vx = rnd.uniform(v0, v1) * self.dir
        self.vy = rnd.uniform(-0.02, 0.02) if name in ("astronaut", "satellite", "probe") else 0.0
        self.x = float(-width - 6 if self.dir > 0 else W + 6)
        self.y = float(rnd.randint(1, max(1, H - self.h - 1)))
        self.bob = rnd.uniform(1.0, 2.5) if name == "ufo" else 0.0
        self.ph = rnd.uniform(0, TAU)
        self.rnd = rnd

    def step(self):
        self.x += self.vx
        self.y += self.vy

    def gone(self, W):
        return self.x > W + 10 or self.x < -self.w - 10

    def draw(self, put, t):
        x0 = int(round(self.x))
        y0 = int(round(self.y + math.sin(t * 0.07 + self.ph) * self.bob))
        ufo = self.name == "ufo"
        for j, line in enumerate(self.lines):
            s = line.strip()
            if not s:
                continue
            a = len(line) - len(line.lstrip())
            for i, ch in enumerate(s):
                c = self.cmap.get(ch, self.base)
                if ufo and ch == "o":
                    c = rgb(*BLINK[(i // 3 + t // 4) % len(BLINK)])
                elif ch == "o" and self.name == "satellite" and (t // 12) % 2:
                    c = rgb(0.3, 0.08, 0.08)
                put(x0 + a + i, y0 + j, ch, c if ch != " " else BLACK)
            if j in self.flames:
                n = self.rnd.randint(2, 5)
                for k in range(n):
                    heat = 1 - k / 5
                    c = rgb(1.0, 0.25 + 0.7 * heat * self.rnd.uniform(0.6, 1), 0.15 * heat)
                    fx = x0 + a - 1 - k if self.dir > 0 else x0 + a + len(s) + k
                    put(fx, y0 + j, self.rnd.choice("=~-:" if k < 3 else "-:."), c)


class Meteor:
    """Падающая звезда."""

    def __init__(self, rnd, W, H):
        self.d = rnd.choice((1, -1))
        self.x = rnd.randint(0, W)
        self.y = rnd.randint(-2, max(0, H // 2))
        self.life = rnd.randint(8, 22)
        self.len = rnd.randint(3, 6)
        self.age = 0

    def step(self):
        self.x += 3 * self.d
        self.y += 1
        self.age += 1

    def draw(self, put):
        seg = ".-'" if self.d < 0 else "'-."
        fade = min(1.0, (self.life - self.age) / 4)
        for i in range(self.len):
            b = (1 - i / self.len) * fade
            c = rgb(0.75 * b, 0.9 * b, b)
            bx = self.x - 3 * self.d * i
            for k in range(3):
                put(bx + k - 1, self.y - i, seg[k], c)
        put(self.x - self.d, self.y, "*", rgb(fade, fade, fade))


class Comet:
    def __init__(self, rnd, W, H):
        self.d = rnd.choice((1, -1))
        self.x = float(-2 if self.d > 0 else W + 2)
        self.y = float(rnd.randint(2, max(3, H - 4)))
        self.vx = rnd.uniform(0.3, 0.55) * self.d
        self.vy = rnd.uniform(-0.05, 0.05)
        self.len = rnd.randint(18, 34)
        self.col = rnd.choice([(0.6, 0.9, 1.0), (0.75, 1.0, 0.8), (1.0, 0.85, 0.6)])
        self.rnd = rnd

    def step(self):
        self.x += self.vx
        self.y += self.vy

    def gone(self, W):
        return self.x > W + self.len + 4 or self.x < -self.len - 4

    def draw(self, put):
        x, y, r = int(round(self.x)), self.y, self.rnd
        slope = self.vy / abs(self.vx)
        for i in range(self.len, 0, -1):
            b = (1 - i / self.len) ** 1.4
            spread = 1 + i // 9
            for s in range(-spread + 1, spread):
                if s and r.random() > 0.55 * (1 - abs(s) / spread):
                    continue
                bb = b * (1.0 if s == 0 else 0.45) * r.uniform(0.75, 1)
                ch = ("=" if i < 4 else "-" if i < 10 else "~" if r.random() < 0.3 else "·") if s == 0 else "."
                put(x - self.d * i, int(round(y - slope * i)) + s, ch,
                    rgb(self.col[0] * bb, self.col[1] * bb, self.col[2] * bb))
        put(x, int(round(y)), "@", rgb(1, 1, 1))
        put(x + self.d, int(round(y)), ")" if self.d > 0 else "(", rgb(*self.col))


# ───────────────────────────── сцена ────────────────────────────

NEBULAE = [((0.75, 0.15, 0.7), (0.15, 0.3, 0.9)), ((0.1, 0.6, 0.65), (0.5, 0.2, 0.8)),
           ((0.85, 0.3, 0.2), (0.7, 0.15, 0.6)), ((0.2, 0.35, 0.9), (0.15, 0.7, 0.55))]
TINTS = [(1, 1, 1), (1, 1, 1), (0.72, 0.82, 1.0), (1.0, 0.95, 0.72), (1.0, 0.76, 0.62)]


class Scene:
    def __init__(self, W, H, seed=None, ships=True):
        self.rnd = random.Random(seed)
        self.ships_on = ships
        self.t = 0
        self.build(W, H)

    def build(self, W, H):
        r = self.rnd
        self.W, self.H = W, H
        # фон: туманность + галактика
        self.base_ch = [[" "] * W for _ in range(H)]
        self.base_co = [[BLACK] * W for _ in range(H)]
        n = Noise(r)
        ca, cb = r.choice(NEBULAE)
        z = r.uniform(0, 100)
        for y in range(H):
            rc, ro = self.base_ch[y], self.base_co[y]
            for x in range(W):
                d = n.fbm(x * 0.022, y * 0.05, z, 4) - 0.57
                if d <= 0:
                    continue
                k = min(1.0, d * 5.5)
                if k < 0.3 and r.random() > 0.25 + k * 2:
                    continue
                c = mix(ca, cb, (n.fbm(x * 0.012 + 40, y * 0.03, z + 9, 2) - 0.3) * 2.5)
                b = 0.3 + 0.45 * k
                rc[x] = "." if k < 0.3 else ":" if k < 0.55 else "░" if k < 0.85 else "▒"
                ro[x] = rgb(c[0] * b, c[1] * b, c[2] * b)
        if W >= 60 and H >= 16:
            self._galaxy(r.randint(W // 6, W * 5 // 6), r.randint(H // 5, H * 4 // 5),
                         r.uniform(9, 16))
        # звёзды: [x, y, слой, фаза, частота, оттенок, гигант]
        self.stars = []
        for _ in range(max(20, W * H // 26)):
            q = r.random()
            layer = 0 if q < 0.62 else 1 if q < 0.92 else 2
            self.stars.append([r.uniform(0, W), r.randint(0, H - 1), layer, r.uniform(0, TAU),
                               r.uniform(0.03, 0.16), r.choice(TINTS),
                               layer == 2 and r.random() < 0.3])
        self.planets, self.ships, self.meteors, self.comets = [], [], [], []
        big = max(3, min(H // 3, W // 9, 13))
        if H >= 12:
            R = r.randint(max(3, big - 3), big)
            self.planets.append(Planet(r, R, r.uniform(W * 0.55, W * 0.82), self._py(R)))
            if W >= 100:
                R2 = r.randint(2, max(2, big // 3))
                self.planets.append(Planet(r, R2, r.uniform(W * 0.1, W * 0.35), self._py(R2)))
        self.ship_in = r.randint(20, 70)
        self.comet_in = r.randint(150, 500)
        self.planet_in = r.randint(300, 900)

    def _py(self, R):
        lo, hi = R // 2 + 1, self.H - R // 2 - 2
        return self.rnd.randint(lo, hi) if hi > lo else self.H // 2

    def _galaxy(self, gx, gy, R):
        r, W, H = self.rnd, self.W, self.H
        rot, tilt = r.uniform(0, TAU), r.uniform(0.35, 0.8)
        ca, sa = math.cos(rot), math.sin(rot)
        tint = r.choice([(0.7, 0.8, 1.0), (1.0, 0.85, 0.75), (0.85, 0.75, 1.0)])

        def dot(px, py, ch, b):
            x = int(round(gx + (px * ca - py * sa * tilt) * 2))
            y = int(round(gy + (px * sa + py * ca * tilt)))
            if 0 <= x < W and 0 <= y < H:
                self.base_ch[y][x] = ch
                self.base_co[y][x] = rgb(tint[0] * b, tint[1] * b, tint[2] * b)
        for arm in range(2):
            for i in range(int(R * 16)):
                t = r.random() ** 0.8
                a = arm * math.pi + t * 4.6 + r.gauss(0, 0.22)
                rad = t * R / 2 + r.gauss(0, 0.25)
                b = 0.85 - 0.6 * t
                dot(math.cos(a) * rad, math.sin(a) * rad, "." if t > 0.35 else ":", b)
        for i in range(int(R * 3)):
            a, rad = r.uniform(0, TAU), abs(r.gauss(0, R * 0.05))
            dot(math.cos(a) * rad, math.sin(a) * rad, "*" if rad < 0.5 else "+", 1.0)
        dot(0, 0, "@", 1.2)

    def step(self):
        r, W, H = self.rnd, self.W, self.H
        self.t += 1
        for s in self.stars:
            s[0] -= (0.012, 0.035, 0.08)[s[2]]
            if s[0] < 0:
                s[0] += W
                s[1] = r.randint(0, H - 1)
        for p in self.planets:
            p.step()
        self.planets = [p for p in self.planets if p.x > -p.ext - 2]
        self.planet_in -= 1
        if self.planet_in <= 0 and len(self.planets) < 2 and H >= 12:
            big = max(3, min(H // 3, W // 9, 13))
            R = r.randint(2, big)
            p = Planet(r, R, 0, self._py(R))
            p.x = W + p.ext + 1
            self.planets.append(p)
            self.planet_in = r.randint(900, 2200)
        for group in (self.ships, self.meteors, self.comets):
            for e in group:
                e.step()
        self.ships = [s for s in self.ships if not s.gone(W)]
        self.comets = [c for c in self.comets if not c.gone(W)]
        self.meteors = [m for m in self.meteors if m.age < m.life]
        if r.random() < 0.012:
            self.meteors.append(Meteor(r, W, H))
        if self.ships_on:
            self.ship_in -= 1
            if self.ship_in <= 0 and len(self.ships) < 3:
                name = r.choice(SHIP_WEIGHTS)
                if H >= len(SPRITES[name][0]) + 2:
                    self.ships.append(Ship(r, name, W, H))
                self.ship_in = r.randint(50, 220)
        self.comet_in -= 1
        if self.comet_in <= 0:
            self.comets.append(Comet(r, W, H))
            self.comet_in = r.randint(700, 1800)

    def compose(self):
        W, H, t = self.W, self.H, self.t
        ch = [row[:] for row in self.base_ch]
        co = [row[:] for row in self.base_co]

        def put(x, y, c, col):
            if 0 <= x < W and 0 <= y < H:
                ch[y][x] = c
                co[y][x] = col
        sin = math.sin
        for x, y, layer, ph, fr, tint, giant in self.stars:
            x = int(x)
            if x >= W:
                continue
            tw = 0.5 + 0.5 * sin(t * fr + ph)
            if layer == 0:
                b, c = 0.22 + 0.3 * tw, "."
            elif layer == 1:
                b = 0.4 + 0.45 * tw
                c = "." if tw < 0.45 else "·" if tw < 0.8 else "+"
            else:
                b = 0.6 + 0.4 * tw
                c = "+" if tw < 0.35 else "*" if tw < 0.75 else "✦"
                if giant and tw > 0.8:
                    f = rgb(tint[0] * 0.4, tint[1] * 0.4, tint[2] * 0.4)
                    put(x - 1, y, "-", f)
                    put(x + 1, y, "-", f)
                    put(x, y - 1, "|", f)
                    put(x, y + 1, "|", f)
            ch[y][x] = c
            co[y][x] = rgb(tint[0] * b, tint[1] * b, tint[2] * b)
        for m in self.meteors:
            m.draw(put)
        for c in self.comets:
            c.draw(put)
        for p in sorted(self.planets, key=lambda p: p.R):
            p.draw(put)
        for s in self.ships:
            s.draw(put, t)
        return ch, co


# ───────────────────────────── вывод ────────────────────────────

def snapshot(args):
    size = shutil.get_terminal_size((100, 32))
    W, H = args.width or size.columns, args.height or size.lines - 1
    sc = Scene(W, H, args.seed, not args.calm)
    for _ in range(args.snapshot):
        sc.step()
    ch, co = sc.compose()
    out = []
    for y in range(H):
        last, row = None, []
        for x in range(W):
            if co[y][x] != last:
                last = co[y][x]
                row.append("\x1b[38;5;%dm" % last)
            row.append(ch[y][x])
        out.append("\x1b[48;5;16m" + "".join(row) + "\x1b[0m")
    sys.stdout.write("\n".join(out) + "\n")


def run(stdscr, args):
    import curses
    curses.curs_set(0)
    stdscr.nodelay(True)
    curses.start_color()
    try:
        curses.use_default_colors()
    except curses.error:
        pass
    full = curses.COLORS >= 256 and curses.COLOR_PAIRS >= 256
    attrs = [0] * 256
    if full:
        bg = -1 if args.transparent else BLACK
        for i in range(1, 256):
            curses.init_pair(i, i, bg)
            attrs[i] = curses.color_pair(i)
    else:  # 8 цветов: грубое приближение
        basic = [curses.COLOR_BLACK, curses.COLOR_RED, curses.COLOR_GREEN, curses.COLOR_YELLOW,
                 curses.COLOR_BLUE, curses.COLOR_MAGENTA, curses.COLOR_CYAN, curses.COLOR_WHITE]
        for i in range(1, 8):
            curses.init_pair(i, basic[i], -1 if args.transparent else curses.COLOR_BLACK)
        for i in range(16, 256):
            if i >= 232:
                v = 8 + 10 * (i - 232)
                r = g = b = v
            else:
                k = i - 16
                r, g, b = _CUBE[k // 36], _CUBE[k // 6 % 6], _CUBE[k % 6]
            m = max(r, g, b)
            if m < 60:
                attrs[i] = curses.color_pair(7) | curses.A_DIM
                continue
            bits = (r > m * 0.6) | ((g > m * 0.6) << 1) | ((b > m * 0.6) << 2)
            attrs[i] = curses.color_pair(bits or 7) | (curses.A_BOLD if m > 200 else 0)
    stdscr.bkgd(" ", attrs[BLACK])

    def new_scene(seed=None):
        H, W = stdscr.getmaxyx()
        stdscr.clear()  # полная перерисовка: после смены размера на экране остаётся мусор
        return Scene(max(W, 10), max(H, 4), seed, not args.calm), None

    sc, prev = new_scene(args.seed)
    delay = 1.0 / args.fps
    paused = False
    nxt = time.monotonic()
    while True:
        k = stdscr.getch()
        while k != -1:
            if k in (ord("q"), ord("Q"), 27):
                return
            if k in (ord("p"), ord("P"), ord(" ")):
                paused = not paused
            elif k in (ord("r"), ord("R")):
                sc, prev = new_scene()
            elif k in (ord("c"), ord("C")):
                sc.ships_on = not sc.ships_on
            elif k == curses.KEY_RESIZE:
                curses.update_lines_cols()
                sc, prev = new_scene()
            k = stdscr.getch()
        if not paused:
            sc.step()
        ch, co = sc.compose()
        H, W = sc.H, sc.W
        for y in range(H):
            rc, ro = ch[y], co[y]
            if prev and prev[0][y] == rc and prev[1][y] == ro:
                continue
            lim = W - 1 if y == H - 1 else W
            x = 0
            try:
                while x < lim:
                    c = ro[x]
                    e = x + 1
                    while e < lim and ro[e] == c:
                        e += 1
                    stdscr.addstr(y, x, "".join(rc[x:e]), attrs[c])
                    x = e
            except curses.error:
                pass
        prev = (ch, co)
        stdscr.refresh()
        nxt += delay
        pause = nxt - time.monotonic()
        if pause > 0:
            time.sleep(pause)
        else:
            nxt = time.monotonic()


def main():
    ap = argparse.ArgumentParser(
        prog="spacii", description="Космос в терминале. Клавиши: q выход, p пауза, "
        "r новая вселенная, c корабли вкл/выкл.")
    ap.add_argument("-t", "--transparent", action="store_true",
                    help="не заливать фон чёрным (для прозрачных терминалов)")
    ap.add_argument("-c", "--calm", action="store_true", help="без кораблей, только космос")
    ap.add_argument("-f", "--fps", type=int, default=20, help="кадров в секунду (по умолчанию 20)")
    ap.add_argument("-s", "--seed", type=int, help="зерно: одна и та же вселенная каждый раз")
    ap.add_argument("--snapshot", type=int, metavar="N",
                    help="напечатать один кадр после N шагов и выйти")
    ap.add_argument("--width", type=int, help=argparse.SUPPRESS)
    ap.add_argument("--height", type=int, help=argparse.SUPPRESS)
    ap.add_argument("-v", "--version", action="version", version="spacii " + VERSION)
    args = ap.parse_args()
    args.fps = max(1, min(60, args.fps))
    if args.snapshot is not None:
        return snapshot(args)
    if not sys.stdout.isatty():
        sys.exit("spacii: нужен терминал (или --snapshot N)")
    import curses
    import locale
    locale.setlocale(locale.LC_ALL, "")
    try:
        curses.wrapper(run, args)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
