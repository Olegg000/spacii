class Salvage(Act):
    """Буксир прилетает за обломками и собирает их по одному."""

    def __init__(self, sc):
        W, H = sc.W, sc.H
        pcs = [p for p in sc.debris if 0 <= p[0] < W and 0 <= p[1] < H] or sc.debris
        ax = sum(p[0] for p in pcs) / len(pcs)
        ay = sum(p[1] for p in pcs) / len(pcs)
        d = -1 if ax > W / 2 else 1
        tug = sc.spawn("tug", d=d, vx=d * 0.6)
        tug.vy, tug.y = 0.0, float(_clamp(ay - 1, 0, H - 2))
        self.tug, self.age, self.leave, self.grab, self.turn = tug, 0, False, 0, 0

    def step(self, sc):
        tug, W, H = self.tug, sc.W, sc.H
        if tug.dead:
            self.done = True
            return
        self.age += 1
        self.grab -= self.grab > 0
        self.turn -= self.turn > 0
        pcs = [p for p in sc.debris if -2 <= p[0] < W + 2 and 0 <= p[1] < H]
        if self.leave or not pcs or self.age > 2200:
            self.leave = True
            tug.vx += (tug.dir * 0.8 - tug.vx) * 0.04
            tug.vy *= 0.9
            return
        clx = tug.x + tug.w if tug.dir > 0 else tug.x - 1
        cly = tug.y + 1
        p = min(pcs, key=lambda p: ((p[0] - clx) / 2) ** 2 + (p[1] - cly) ** 2)
        dx, dy = p[0] - clx, p[1] - cly
        if dx * tug.dir < -3 and not self.turn:
            tug.face(-tug.dir)
            self.turn = 40
            return
        dist = math.hypot(dx / 2, dy) + 1e-6
        sp = min(0.5, 0.06 + dist * 0.04)
        tug.vx += (dx / dist * sp - tug.vx) * 0.12
        tug.vy += (dy / dist * sp - tug.vy) * 0.12
        if abs(dx) < 1.6 and abs(dy) < 0.9:
            sc.debris.remove(p)
            self.grab = 5

    def over(self, put, t):
        if self.grab:
            tug = self.tug
            put(int(round(tug.x + tug.w if tug.dir > 0 else tug.x - 1)), int(round(tug.y)) + 1, "*",
                rgb(1.0, 1.0, 0.6))


