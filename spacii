class Ship:
    def __init__(self, rnd, name, W, H, d=None, x=None, y=None, vx=None):
        art, base, cmap, flames, (v0, v1), mirror = SPRITES[name]
        self.name, self.rnd, self.mirror = name, rnd, mirror
        fr = FRAMES.get(name)
        self.period, self.raw = (fr[0], fr[1]) if fr else (0, [art])
        self.w = max(len(l) for f in self.raw for l in f)
        self.h = max(len(f) for f in self.raw)
        self.base = rgb(*base)
        self._cmap = {k: rgb(*v) for k, v in cmap.items()}
        bl = BLINKS.get(name)
        self.blink = (bl[0], [rgb(*c) for c in bl[1]], bl[2]) if bl else None
        self.flames = flames
        self.face(d or rnd.choice((1, -1)))
        width = self.w
        self.vx = vx if vx is not None else rnd.uniform(v0, v1) * self.dir
        self.vy = rnd.uniform(-0.02, 0.02) if name in DRIFTERS or name[:4] == "rock" else 0.0
        self.x = float(-width - 6 if self.dir > 0 else W + 6) if x is None else float(x)
        self.y = float(rnd.randint(1, max(1, H - self.h - 1))) if y is None else float(y)
        if name == "jelly":
            self.x = rnd.uniform(4, max(5, W - width - 4))
            self.y = H + 1 + rnd.uniform(0, 10)
            self.vy = -rnd.uniform(0.05, 0.1)
        self.vx0, self.vy0 = self.vx, self.vy
        self.bob = {"ufo": 2.0, "abduction": 1.2, "whale": 1.6, "bsaucer": 1.0}.get(name, 0.0) * \
            rnd.uniform(0.6, 1.2)
        self.ph = rnd.uniform(0, TAU)
        self.fph = rnd.randint(0, 7)
        self.gun, self.dead = 0, False
        self.team, self.hp, self.must, self.cool = 0, 1, False, 0
        self.hidden, self.clip, self.thrust, self.wave = False, None, True, 0
        self.rock = name in ROCKS
        self.jump = None
        if name in JUMPERS and x is None and rnd.random() < 0.3:
            self.jump = rnd.uniform(W * 0.3, W * 0.7)

    def face(self, d):
        """Развернуть спрайт (пересобирает строки; скорость не трогает)."""
        self.dir = d
        flip = d < 0 and self.mirror
        w, h = self.w, self.h

        def prep(l):
            l = l.rstrip().ljust(w)
            return l[::-1].translate(MIRROR) if flip else l
        frames = []
        for f in self.raw:
            px, py = (w - max(len(l) for l in f)) // 2, (h - len(f)) // 2
            rows = [""] * py + [" " * px + l for l in f]
            frames.append([prep(l) for l in rows + [""] * (h - len(rows))])
        self.frames, self.lines = frames, frames[0]
        self.alt = {j: prep(l) for j, l in ANIM.get(self.name, {}).items()}
        self.wav = [{j: prep(l) for j, l in v.items()} for v in WAVE.get(self.name, ())]
        self.cmap = {(k.translate(MIRROR) if flip else k): c for k, c in self._cmap.items()}

    @property
    def cx(self):
        return self.x + self.w / 2

    @property
    def cy(self):
        return self.y + self.h / 2

    def step(self):
        if self.wave:
            self.wave -= 1
        if self.name in ("jelly", "droid"):
            if self.name == "droid" and self.rnd.random() < 0.015:
                self.vy = self.rnd.uniform(-0.15, 0.15)
            self.vx = self.vx0 + (self.vx - self.vx0) * 0.96
            self.vy = self.vy0 + (self.vy - self.vy0) * 0.96
        self.x += self.vx
        self.y += self.vy

    def gone(self, W, H):
        return self.dead or self.x > W + 90 or self.x < -self.w - 90 or \
            (self.y < -self.h - 2 and self.vy <= 0) or self.y > H + 14

    def draw(self, put, t):
        if self.hidden:
            return
        if self.clip:
            lo, hi = self.clip
            put0 = put

            def put(x, y, c, col):
                if lo <= x < hi:
                    put0(x, y, c, col)
        x0 = int(round(self.x))
        y0 = int(round(self.y + math.sin(t * 0.07 + self.ph) * self.bob))
        name = self.name
        lights = name in ("ufo", "abduction")
        lines = self.frames[(t // self.period + self.fph) % len(self.frames)] if self.period \
            else self.lines
        alt = self.alt if (t // 9) % 2 else None
        if self.wave and self.wav:
            alt = self.wav[(t // 5) % 2]
        blink, nb = self.blink, 0
        cmap, base = self.cmap, self.base
        for j, line in enumerate(lines):
            if alt and j in alt:
                line = alt[j]
            s = line.strip()
            if not s:
                continue
            a = len(line) - len(line.lstrip())
            for i, ch in enumerate(s):
                c = cmap.get(ch, base)
                if lights and j == 3 and ch == "o":
                    c = rgb(*BLINK[(i // 3 + t // 4) % len(BLINK)])
                elif ch == "o" and name == "satellite" and (t // 12) % 2:
                    c = rgb(0.3, 0.08, 0.08)
                elif blink and ch == blink[0]:
                    c = blink[1][(nb + t // blink[2]) % len(blink[1])]
                    nb += 1
                put(x0 + a + i, y0 + j, ch, c if ch != " " else BLACK)
            if self.thrust and j in self.flames:
                n = self.rnd.randint(2, 5)
                for k in range(n):
                    heat = 1 - k / 5
                    c = rgb(1.0, 0.25 + 0.7 * heat * self.rnd.uniform(0.6, 1), 0.15 * heat)
                    fx = x0 + a - 1 - k if self.dir > 0 else x0 + a + len(s) + k
                    put(fx, y0 + j, self.rnd.choice("=~-:" if k < 3 else "-:."), c)
        if name == "bsaucer":                       # реквизит на леске
            c = rgb(0.32, 0.32, 0.34)
            for y in range(0, y0):
                put(x0 + 9, y, "|" if (y + t // 6) % 3 else ":", c)
        elif name == "dish":                        # радиоволны
            tip = x0 + (self.w if self.dir > 0 else -1)
            d = self.dir
            for k in range(3):
                r = (t * 0.25 + k * 7) % 21
                f = 1 - r / 21
                c = rgb(0.4 * f, 0.9 * f, 0.6 * f)
                x, sp = tip + d * int(r), 1 + int(r // 8)
                put(x, y0 + 2, ")" if d > 0 else "(", c)
                for q in range(1, sp + 1):
                    put(x - d * (q - 1), y0 + 2 - q, "\\" if d > 0 else "/", c)
                    put(x - d * (q - 1), y0 + 2 + q, "/" if d > 0 else "\\", c)


class Streak:
    """Прыжок в гиперпространство."""

    def __init__(self, x, y, d, rows):
        self.x, self.y, self.d, self.rows, self.age = int(x), int(y), d, rows, 0

    def step(self):
        self.age += 1

    @property
    def done(self):
        return self.age > 10

    def draw(self, put):
        ln = 3 + self.age * self.age * 2
        fade = 1 - self.age / 11
        for r in range(self.rows):
            for i in range(ln):
                k = i / ln * fade
                put(self.x + self.d * i, self.y + r, "=" if i > ln * 0.6 else "-",
                    rgb(0.5 * k + 0.2 * fade, 0.8 * k + 0.1 * fade, k + 0.2 * fade))


class Explosion:
    def __init__(self, rnd, x, y, R, cols, fuse=0):
        self.x, self.y, self.R, self.age = x, y, R, 0
        self.fuse = self.fuse0 = fuse
        self.parts = []
        for _ in range(int(30 + R * R * 7)):
            a = rnd.uniform(0, TAU)
            d = rnd.random() ** 0.5 * R
            sp = rnd.uniform(0.05, 0.22) * (1 + R * 0.25) * (0.3 + d / max(R, 1))
            life = rnd.randint(30, 60 + R * 22)
            self.parts.append([x + math.cos(a) * d * 2, y + math.sin(a) * d, math.cos(a) * sp * 2,
                               math.sin(a) * sp, life, life, rnd.choice("#*+o:.'`,"),
                               rnd.choice(cols)])
        self.ring_life = 40 + R * 10

    def step(self):
        if self.fuse > 0:
            self.fuse -= 1
            return
        self.age += 1
        for p in self.parts:
            p[0] += p[2]
            p[1] += p[3]
            p[2] *= 0.99
            p[3] *= 0.99
            p[4] -= 1
        self.parts = [p for p in self.parts if p[4] > 0]

    @property
    def done(self):
        return self.fuse <= 0 and not self.parts and self.age > self.ring_life

    def draw(self, put):
        x0, y0, R, a = int(round(self.x)), int(round(self.y)), self.R, self.age
        if self.fuse > 0:
            k = 1 - self.fuse / self.fuse0
            w = rgb(1, 1, 1)
            for i in range(1, int(k * 6) + 1):
                c = rgb(1 - i * 0.12, 1 - i * 0.12, 1)
                put(x0 - i, y0, "-", c)
                put(x0 + i, y0, "-", c)
                if i % 2 == 0:
                    put(x0, y0 - i // 2, "|", c)
                    put(x0, y0 + i // 2, "|", c)
            put(x0, y0, "✦" if k > 0.3 else "*", w)
            return
        if a < self.ring_life:
            rad = R + a * (0.35 + R * 0.06)
            fade = 1 - a / self.ring_life
            c = rgb(0.6 * fade, 0.8 * fade, fade)
            n = int(rad * 10) + 8
            for i in range(n):
                th = i / n * TAU
                put(x0 + int(round(math.cos(th) * rad * 2)), y0 + int(round(math.sin(th) * rad)),
                    ":" if fade > 0.5 else "·", c)
        for p in self.parts:
            f = p[4] / p[5]
            col, hot = p[7], f * f
            put(int(p[0]), int(p[1]), p[6] if f > 0.3 else ".",
                rgb(col[0] * f + hot * 0.5, col[1] * f + hot * 0.3, col[2] * f))
        if a < 8:
            rr = R * (0.6 + a * 0.15)
            for dy in range(-int(rr), int(rr) + 1):
                w = int(2 * math.sqrt(max(0.0, rr * rr - dy * dy)))
                for dx in range(-w, w + 1):
                    put(x0 + dx, y0 + dy, "@" if a < 4 else "#", rgb(1, 1, 1 - a * 0.08))


class BlackHole:
    def __init__(self, rnd, W, H):
        self.R = R = max(3, min(5, H // 9))
        self.ext = R * 6
        self.x = float(W + self.ext + 1)
        self.y = float(rnd.randint(R + 3, max(R + 3, H - R - 4)))
        self.cells = []
        rr = R + 0.3
        for dy in range(-R - 2, R + 3):
            for dx in range(-self.ext, self.ext + 1):
                px, py = dx / (2 * rr), dy / rr
                d = math.hypot(px, py)
                q = math.hypot(px, py / 0.2)
                if 1.25 < q < 2.7 and (py >= 0 or d >= 1):
                    self.cells.append((dx, dy, 2, math.atan2(py / 0.2, px), (q - 1.25) / 1.45))
                elif d < 0.92:
                    self.cells.append((dx, dy, 0, 0.0, 0.0))
                elif d < 1.15:
                    self.cells.append((dx, dy, 1, math.atan2(py, px), 0.0))
                elif d < 1.5 and py < 0:
                    self.cells.append((dx, dy, 3, math.atan2(py, px), (d - 1.15) / 0.35))

        self.flare = 0

    def step(self):
        self.x -= 0.06
        if self.flare:
            self.flare -= 1

    def draw(self, put, t):
        cx, cy, sin = int(round(self.x)), int(round(self.y)), math.sin
        fl = 1 + self.flare / 25
        for dx, dy, k, a, q in self.cells:
            if k == 0:
                put(cx + dx, cy + dy, " ", BLACK)
            elif k == 1:
                b = 0.75 + 0.25 * sin(a * 2 + t * 0.1)
                put(cx + dx, cy + dy, "@" if b > 0.85 else "#", rgb(b, b * 0.85, b * 0.5))
            elif k == 2:
                b = (0.55 + 0.45 * sin(a * 2 - t * 0.12 + q * 5)) * (1 - 0.5 * q) * \
                    (1.15 if dx < 0 else 0.8) * fl
                put(cx + dx, cy + dy, "=" if b > 0.6 else "-" if b > 0.35 else "·",
                    rgb(b, b * (0.75 - 0.35 * q), b * (0.4 - 0.3 * q)))
            else:
                b = (1 - q) * 0.7 * (0.7 + 0.3 * sin(a * 3 + t * 0.1))
                if b > 0.12:
                    put(cx + dx, cy + dy, ":" if b > 0.4 else ".", rgb(b, b * 0.6, b * 0.2))


def _tex_station(side):
    def kind(n, rnd):
        c = (0.81, -0.42, 0.4 * side)

        def f(p, lat):
            lon = math.atan2(p[2], p[0])
            g = 0.48 + 0.25 * n.n3(math.floor(lon * 9) * 1.7, math.floor(lat * 11) * 1.3, 1.5)
            if abs(lat) < 0.05:
                g = 0.18
            d = math.sqrt((p[0] - c[0]) ** 2 + (p[1] - c[1]) ** 2 + (p[2] - c[2]) ** 2)
            if d < 0.36:
                g = 0.9 if d > 0.29 else 0.95 if d < 0.07 else 0.25 + d
            elif n.n3(lon * 40, lat * 40, 7.0) > 0.84:
                return (1.0, 0.9, 0.5, 0.45)
            return (g, g, g * 1.06, 0.0)
        return f, None
    return kind


class Station:
    """Боевая станция размером с луну."""

    def __init__(self, rnd, W, H, target, hold=False):
        self.rnd, self.W = rnd, W
        self.R = R = max(4, min(8, H // 5))
        self.target = target
        tx, ty, tr = _aim(target) if target is not None else (0, 0, 0)
        self.side = 1 if (target is None or tx < W / 2) else -1   # 1: станция справа
        if hold:
            self.side = rnd.choice((1, -1))
        self.p = p = Planet(rnd, R, 0, 0, kind=_tex_station(-self.side), plain=True)
        p.spin = p.speed = p.rot = 0.0
        self.ext = 2 * R + 3
        self.home = W + self.ext if self.side > 0 else -self.ext
        p.x = float(self.home)
        ty = ty + rnd.randint(-5, 5) if target else rnd.randint(R + 1, max(R + 1, H - R - 2))
        p.y = float(max(R + 1, min(H - R - 2, ty)))
        self.stop = W * (0.85 if self.side > 0 else 0.15)
        self.state, self.age, self.done, self.hold = "in", 0, False, hold
        self.ship = target is not None and not isinstance(target, Planet)
        if hold:
            self.target = None
        elif target is None or (not self.ship and abs(self.stop - tx) < 2 * (R + tr) + 8):
            self.target, self.state = None, "pass"

    def step(self, scene):
        p, s = self.p, self.side
        self.age += 1
        tg = self.target
        if tg is not None and (tg.dead if self.ship else tg not in scene.planets):
            self.target, self.state = None, "out"
        st = self.state
        if st == "pass":
            p.x -= 0.14 * s
            self.done = (p.x + self.ext < 0) if s > 0 else (p.x - self.ext > self.W)
        elif st == "in":
            p.x -= 0.3 * s
            if (p.x - self.stop) * s <= 0:
                self.state = "hold" if self.hold else "aim" if self.ship else "charge"
                self.age = 0
        elif st == "aim":                            # ждём, пока корабль выйдет на середину
            tx = _aim(self.target)[0]
            if self.W * 0.2 < tx < self.W * 0.8 and abs(tx - p.x) > 2 * self.R + 14:
                self.state, self.age = "charge", 0
            elif self.age > 700:
                self.state = "out"
        elif st == "hold":
            pass
        elif st == "charge":
            if self.age > 50:
                self.state, self.age = "fire", 0
        elif st == "fire":
            if not self.ship:
                self.target.heat = min(1.0, self.age / 38)
            if self.age > 44:
                if self.ship:
                    scene.wreck(self.target, 2)
                else:
                    scene.destroy(self.target)
                self.target, self.state, self.age = None, "wait", 0
        elif st == "wait":
            if self.age > 80:
                self.state = "out"
        else:
            p.x += 0.35 * s
            self.done = (p.x - self.home) * s >= 0

    def draw(self, put, t):
        p, R, r = self.p, self.R, self.rnd
        p.draw(put)
        cx, cy = int(round(p.x)), int(round(p.y))
        for i in range(-2 * R + 2, 2 * R - 1):          # экваториальный жёлоб
            b = 0.3 - 0.12 * i / (2 * R)
            put(cx + i, cy, "+" if i % 5 == 0 else "=", rgb(b, b, b * 1.1))
        dx = cx + int(round(-self.side * 0.4 * 2 * (R + 0.35)))
        dy = cy + int(round(-0.42 * (R + 0.35)))
        rim = rgb(0.92, 0.92, 0.97)                     # тарелка
        for j, row in enumerate((" .-. ", "( o )", " `-' ") if R >= 6 else ("(o)",)):
            for i, ch in enumerate(row):
                if ch != " " or j == 1:
                    put(dx - len(row) // 2 + i, dy - (1 if R >= 6 else 0) + j, ch,
                        rgb(0.2, 0.45, 0.2) if ch == "o" else rim)
        if self.state == "charge":
            k = self.age / 50
            for _ in range(int(2 + k * 8)):
                rad = (1 - k) * 4 + 1
                a = r.uniform(0, TAU)
                put(dx + int(math.cos(a) * rad * 2), dy + int(math.sin(a) * rad), ".",
                    rgb(0.2, 0.5 + 0.5 * r.random(), 0.2))
            put(dx, dy, "*", rgb(0.3 + 0.7 * k, 1, 0.3 + 0.7 * k))
        elif self.state == "fire":
            tx, ty, _ = _aim(self.target)
            tx, ty = int(round(tx)), int(round(ty))
            ex, ey = tx - dx, ty - dy
            n = max(abs(ex), abs(ey), 1)
            slope = ey / ex if ex else 9
            ch = "=" if abs(slope) < 0.18 else "~" if abs(slope) < 0.5 else \
                ("\\" if slope > 0 else "/")
            for i in range(n + 1):
                f = r.uniform(0.7, 1)
                put(dx + ex * i // n, dy + ey * i // n, ch,
                    rgb(1, 1, 1) if (i + t) % 5 == 0 else rgb(0.25 * f, f, 0.25 * f))
            put(dx, dy, "@", rgb(0.8, 1, 0.8))


class Meteor:
    """Падающая звезда."""

    def __init__(self, rnd, W, H):
        self.d = rnd.choice((1, -1))
        self.x = rnd.randint(0, W)
        self.y = rnd.randint(-2, max(0, H // 2))
        self.life = rnd.randint(8, 22)
        self.len = rnd.randint(3, 6)
        self.age = 0

    def step(self):
        self.x += 3 * self.d
        self.y += 1
        self.age += 1

    def draw(self, put):
        seg = ".-'" if self.d < 0 else "'-."
        fade = min(1.0, (self.life - self.age) / 4)
        for i in range(self.len):
            b = (1 - i / self.len) * fade
            c = rgb(0.75 * b, 0.9 * b, b)
            bx = self.x - 3 * self.d * i
            for k in range(3):
                put(bx + k - 1, self.y - i, seg[k], c)
        put(self.x - self.d, self.y, "*", rgb(fade, fade, fade))


class Comet:
    def __init__(self, rnd, W, H, planet=None):
        self.d = rnd.choice((1, -1))
        self.x = float(-2 if self.d > 0 else W + 2)
        self.y = float(rnd.randint(2, max(3, H - 4)))
        self.vx = rnd.uniform(0.3, 0.55) * self.d
        self.vy = rnd.uniform(-0.05, 0.05)
        if planet is not None:                       # прицельно в планету, с упреждением
            # бьём в тот край, от которого вращение пронесёт кратер через весь диск
            self.d = -1 if planet.spin > 0 else 1
            self.x = float(-2 if self.d > 0 else W + 2)
            self.vx = 0.5 * self.d
            self.y = float(max(1, min(H - 2, planet.y + rnd.uniform(-0.3, 0.3) * H)))
            tx = planet.x - planet.speed * abs(planet.x - self.x) / (0.5 + planet.speed * self.d)
            tx -= self.d * planet.R * 0.6
            self.vy = (planet.y - self.y) / max(1.0, abs(tx - self.x) / 0.5)
        self.len = rnd.randint(18, 34)
        self.col = rnd.choice([(0.6, 0.9, 1.0), (0.75, 1.0, 0.8), (1.0, 0.85, 0.6)])
        self.rnd = rnd

    def step(self):
        self.x += self.vx
        self.y += self.vy

    def gone(self, W):
        return self.x > W + self.len + 4 or self.x < -self.len - 4

    def draw(self, put):
        x, y, r = int(round(self.x)), self.y, self.rnd
        slope = self.vy / abs(self.vx)
        for i in range(self.len, 0, -1):
            b = (1 - i / self.len) ** 1.4
            spread = 1 + i // 9
            for s in range(-spread + 1, spread):
                if s and r.random() > 0.55 * (1 - abs(s) / spread):
                    continue
                bb = b * (1.0 if s == 0 else 0.45) * r.uniform(0.75, 1)
                ch = ("=" if i < 4 else "-" if i < 10 else "~" if r.random() < 0.3 else "·") if s == 0 else "."
                put(x - self.d * i, int(round(y - slope * i)) + s, ch,
                    rgb(self.col[0] * bb, self.col[1] * bb, self.col[2] * bb))
        put(x, int(round(y)), "@", rgb(1, 1, 1))
        put(x + self.d, int(round(y)), ")" if self.d > 0 else "(", rgb(*self.col))


def _aim(o):
    """Центр и радиус цели: планеты или корабля."""
    if isinstance(o, Planet):
        return o.x, o.y, o.R
    return o.cx, o.cy, o.h / 2


class Text:
    """Короткая надпись или пузырёк: всплывает и гаснет. anchor: следовать за кораблём."""

    def __init__(self, x, y, s, col, life=50, vy=-0.06, delay=0, anchor=None):
        self.x, self.y, self.s, self.col = x, y, s, col
        self.life, self.vy, self.delay, self.age, self.anchor = life, vy, delay, 0, anchor

    def step(self):
        if self.delay > 0:
            self.delay -= 1
            return
        self.age += 1
        self.y += self.vy

    @property
    def done(self):
        return self.age >= self.life

    def draw(self, put):
        if self.delay > 0:
            return
        f = min(1.0, (self.life - self.age) / 15)
        c = rgb(self.col[0] * f, self.col[1] * f, self.col[2] * f)
        x, y = self.x, self.y
        if self.anchor is not None:
            x, y = x + self.anchor.x, y + self.anchor.y
        x, y = int(round(x)), int(round(y))
        for i, ch in enumerate(self.s):
            put(x + i, y, ch, c)


class Flash:
    """Короткая вспышка: белое ядро и разлетающиеся искры."""

    def __init__(self, rnd, x, y, R=2, col=(0.7, 0.85, 1.0), life=14):
        self.x, self.y, self.R, self.col, self.life, self.age = x, y, R, col, life, 0
        self.sparks = [(rnd.uniform(0, TAU), rnd.uniform(0.6, 1.25), rnd.choice("*+.'"))
                       for _ in range(int(6 + R * 5))]

    def step(self):
        self.age += 1

    @property
    def done(self):
        return self.age >= self.life

    def draw(self, put):
        k = self.age / self.life
        x0, y0, col = int(round(self.x)), int(round(self.y)), self.col
        rr = self.R * (0.5 + 1.2 * k)
        if k < 0.4:
            core = self.R * (0.9 - k)
            w = rgb(1, 1, 1)
            for dy in range(-int(core * 0.5), int(core * 0.5) + 1):
                hw = int(core * math.sqrt(max(0.0, 1 - (dy / (core * 0.5 + 0.5)) ** 2)))
                for dx in range(-hw, hw + 1):
                    put(x0 + dx, y0 + dy, "@" if k < 0.2 else "#", w)
        f = 1 - k
        c = rgb(col[0] * f + 0.2 * f, col[1] * f + 0.1 * f, col[2] * f)
        for a, q, ch in self.sparks:
            put(x0 + int(round(math.cos(a) * rr * q * 2)), y0 + int(round(math.sin(a) * rr * q)),
                ch, c)


class Spaghetti:
    """Корабль, растянутый и закрученный чёрной дырой."""

    def __init__(self, rnd, s, hole):
        self.h, self.age = hole, 0
        parts = []
        for j, line in enumerate(s.lines):
            for i, ch in enumerate(line):
                if ch != " ":
                    px, py = (s.x + i - hole.x) / 2, s.y + j - hole.y
                    parts.append([math.atan2(py, px), math.hypot(px, py), s.cmap.get(ch, s.base), ch])
        self.parts = rnd.sample(parts, 70) if len(parts) > 70 else parts
        self.lim = 0.95 * (hole.R + 0.3)

    def step(self):
        self.age += 1
        for p in self.parts:
            p[1] = self.lim * 0.9 + (p[1] - self.lim * 0.9) * 0.965
            p[0] += 0.45 / (p[1] + 0.6)
        self.parts = [p for p in self.parts if p[1] > self.lim]

    @property
    def done(self):
        return not self.parts or self.age > 400

    def draw(self, put):
        hx, hy, cos, sin = self.h.x, self.h.y, math.cos, math.sin
        glow = rgb(1.0, 0.7, 0.35)
        for a, rad, c, ch in self.parts:
            x, y = int(round(hx + cos(a) * rad * 2)), int(round(hy + sin(a) * rad))
            if self.age > 6:
                ch, c = ("~" if rad > self.lim * 1.6 else "-"), (c if rad > self.lim * 1.3 else glow)
                b = a - 0.5 / (rad + 0.6)
                put(int(round(hx + cos(b) * rad * 2)), int(round(hy + sin(b) * rad)), "-", c)
            put(x, y, ch, c)


PORTAL_COLS = [(0.6, 0.3, 1.0), (0.3, 0.8, 1.0), (0.95, 0.95, 1.0), (0.8, 0.45, 1.0), (0.3, 0.5, 1.0)]


class Portal:
    """Кольцо-портал: открывается, крутится, закрывается."""

    def __init__(self, x, y, ry):
        self.x, self.y, self.ry, self.k, self.open, self.t = x, y, ry, 0.0, True, 0
        self.cols = [rgb(*c) for c in PORTAL_COLS]

    def step(self):
        self.t += 1
        self.k = min(1.0, self.k + 0.07) if self.open else max(0.0, self.k - 0.07)

    @property
    def done(self):
        return not self.open and self.k <= 0

    def draw(self, put):
        k = self.k
        if k <= 0:
            return
        ry, rx = max(0.6, self.ry * k), max(1.0, 2.6 * k)
        cols, nc = self.cols, len(self.cols)
        x0, y0, n = int(round(self.x)), int(round(self.y)), int(ry)
        for j in range(-n, n + 1):
            off = int(round(rx * math.sqrt(max(0.0, 1 - (j / (n + 0.5)) ** 2))))
            ca, cb = cols[(j + self.t // 2) % nc], cols[(-j + self.t // 2) % nc]
            if abs(j) == n:
                for i in range(-off, off + 1):
                    put(x0 + i, y0 + j, "-", ca)
            else:
                put(x0 - off, y0 + j, "(", ca)
                put(x0 + off, y0 + j, ")", cb)
        for j in range(3):
            a = self.t * 0.15 + j * TAU / 3
            put(int(round(self.x + math.cos(a) * rx * 0.5)), int(round(self.y + math.sin(a) * ry * 0.5)),
                "*" if j == 0 else ".", cols[(j + self.t // 3) % nc])


class FireTrail:
    """Две огненные полосы на месте исчезнувшей машины."""

    def __init__(self, rnd, x, rows, d, length):
