def _clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


class Chase(Act):
    """Патруль с мигалкой гонится за лихачом: тот уходит в прыжок или его берут лучом на буксир."""
    need = (70, 10)

    def __init__(self, sc):
        r, H = sc.rnd, sc.H
        self.d = d = r.choice((1, -1))
        cop = sc.spawn("patrol", d=d, vx=d * 1.0)
        sp = sc.spawn("speeder", d=d, vx=d * 0.95)
        cop.vy = sp.vy = 0.0
        cop.y = float(r.randint(2, max(2, H - cop.h - 3)))
        sp.y = cop.y + 1
        cop.x = sp.x - cop.w - 24 if d > 0 else sp.x + sp.w + 24
        self.sp, self.cop = sp, cop
        self.fate = r.choice(("jump", "tow", "tow"))
        self.state, self.age = "chase", 0

    def _hitch(self):
        sp, cop = self.sp, self.cop
        sp.x = cop.x + cop.w + 5 if self.d > 0 else cop.x - sp.w - 5

    def step(self, sc):
        sp, cop, d, W, H = self.sp, self.cop, self.d, sc.W, sc.H
        self.age += 1
        st = self.state
        if cop.dead or (sp.dead and st in ("beam", "hold", "tow")):
            if not sp.dead:
                sp.thrust, sp.vx = True, d * 1.0
            self.done = True
            return
        if st == "chase":
            if sp.dead:
                self.state = "lost"
                return
            sp.vy = 0.1 * math.cos(self.age * 0.06)
            if (sp.y < 1 and sp.vy < 0) or (sp.y > H - sp.h - 1 and sp.vy > 0):
                sp.vy = 0.0
            cop.vy = (sp.y - 1 - cop.y) * 0.05
            gap = sp.x - cop.x - cop.w if d > 0 else cop.x - sp.x - sp.w
            front = sp.x + sp.w if d > 0 else sp.x
            if self.fate == "jump":
                if (front - W * (0.5 + 0.12 * d)) * d > 0:
                    sc.fx.append(Streak(sp.x + (0 if d > 0 else sp.w), sp.y + 1, d, 1))
                    sp.dead = True
                    sc.fx.append(Text(cop.cx, cop.y - 1, "?", (1.0, 1.0, 0.6), 70, -0.03))
                    self.state = "lost"
            else:
                cop.vx = d * 1.2
                inside = (front - W * (0.5 + 0.2 * d)) * d < 0
                if gap < 5 and inside:
                    self.state, self.age = "beam", 0
                elif (front - W / 2) * d > W / 2 + 10:
                    self.done = True
        elif st == "lost":
            cop.vx += (d * 0.3 - cop.vx) * 0.03
            cop.vy *= 0.9
        elif st == "beam":
            cop.vy *= 0.85
            sp.vy = 0.0
            sp.y += (cop.y + 1 - sp.y) * 0.15
            cop.vx *= 0.95
            sp.vx = cop.vx
            self._hitch()
            if abs(cop.vx) < 0.04:
                cop.vx = sp.vx = 0.0
                self.state, self.age = "hold", 0
        elif st == "hold":
            sp.thrust = False
            sp.y = cop.y + 1
            if self.age > 45:
                cop.face(-d)
                self.state = "tow"
        elif st == "tow":
            cop.vx += (-d * 0.55 - cop.vx) * 0.03
            sp.vx = cop.vx
            self._hitch()

    def over(self, put, t):
        if self.state not in ("beam", "hold", "tow"):
            return
        sp, cop, d = self.sp, self.cop, self.d
        x0 = int(round(cop.x + cop.w)) if d > 0 else int(round(sp.x + sp.w))
        x1 = int(round(sp.x)) + 1 if d > 0 else int(round(cop.x))
        y = int(round(cop.y)) + 2
        for x in range(x0, x1):
            k = (x - t) % 3
            put(x, y, "~" if k == 0 else "-", rgb(0.35, 0.75 + 0.25 * (k == 0), 1.0))


class Docking(Act):
    """Ракета подходит к орбитальной станции, стыкуется, стоит, отстыковывается и уходит."""
    need = (90, 9)
    NOSE = 17                                        # колонка носа ракеты

    def __init__(self, sc):
        r, H = sc.rnd, sc.H
        st = sc.spawn("orbital", d=-1, vx=-0.5)
        st.vy = 0.0
        st.y = float(r.randint(2, max(2, H - 6)))
        self.st, self.rk, self.state, self.age = st, None, "in", 0
        self.tx = sc.W * r.uniform(0.52, 0.62)

    def step(self, sc):
        st, rk, n = self.st, self.rk, self.NOSE
        self.age += 1
        if st.dead or (rk is not None and rk.dead):
            if rk is not None and not rk.dead:
                rk.thrust, rk.vx = True, rk.dir * 0.8
            if not st.dead:
                st.vx = -0.1
            self.done = True
            return
        s = self.state
        if s == "in":
            st.vx = -max(0.06, min(0.5, (st.x - self.tx) * 0.012))
            if rk is None and st.x < sc.W * 0.85:
                rk = self.rk = sc.spawn("rocket", d=1, vx=0.8)
                rk.vy, rk.y = 0.0, st.y
            if rk is not None:
                gap = st.x - (rk.x + n)
                rk.vx = st.vx + max(0.04, min(0.8, gap * 0.03))
                if gap <= 0.3:
                    rk.x, rk.thrust = st.x - n, False
                    self.state, self.age = "dock", 0
        elif s == "dock":
            st.vx = -0.06
            rk.vx, rk.x = st.vx, st.x - n
            if self.age > 150:
                self.state, self.age = "undock", 0
        elif s == "undock":
            rk.vx = st.vx - 0.1
            if st.x - (rk.x + n) > 5:
                rk.face(-1)
                rk.thrust = True
                self.state = "leave"
        else:
            rk.vx = max(-1.0, rk.vx - 0.02)
            st.vx += (-0.1 - st.vx) * 0.02

    def over(self, put, t):
        if self.state == "dock":
            on = (t // 6) % 2
            x, y = int(round(self.st.x)), int(round(self.st.y))
            put(x, y, "*" if on else ".", rgb(0.3, 1.0, 0.4) if on else rgb(0.1, 0.35, 0.15))
            put(x, y + 3, "." if on else "*", rgb(0.1, 0.35, 0.15) if on else rgb(0.3, 1.0, 0.4))


class Beamup(Act):
    """НЛО зависает над астронавтом (или коровой), затягивает лучом; иногда роняет обратно."""
    need = (60, 18)

    def __init__(self, sc):
        r, H = sc.rnd, sc.H
        self.d = d = r.choice((1, -1))
        name = "cow" if r.random() < 0.3 else "astronaut"
        a = sc.spawn(name, d=d, vx=d * 0.4)
        a.vy = 0.0
        a.y = float(r.randint(9, max(9, H - a.h - 1)))
        self.a, self.u, self.y0 = a, None, a.y
        self.stop = sc.W * r.uniform(0.35, 0.65)
        self.drop = r.random() < 0.35
        self.zd = r.choice((1, -1))
        self.state, self.age = "drift", 0

    def step(self, sc):
        a, u, r = self.a, self.u, sc.rnd
        self.age += 1
        s = self.state
        if u is not None and u.dead:
            if a.hidden:
                a.dead = True
            self.done = True
            return
        if a.dead and s in ("drift", "beam"):
            if u is not None:
                self.state, self.age = "zip", 99
            else:
                self.done = True
            return
        if s == "drift":
            a.vx = self.d * max(0.05, min(0.4, abs(self.stop - a.cx) * 0.012))
            if u is None and abs(self.stop - a.cx) < sc.W * 0.3:
                ud = r.choice((1, -1))
                u = self.u = sc.spawn("ufo", d=ud, vx=ud * 0.9)
                u.bob, u.vy = 0.0, 0.0
                u.y = a.y - u.h - 3
            if u is not None:
                dx = a.cx - u.cx
                u.vx = a.vx + _clamp(dx * 0.04, -0.9, 0.9)
                if abs(dx) < 0.7 and abs(self.stop - a.cx) < 10:
                    self.state, self.age = "beam", 0
        elif s == "beam":
            a.vx *= 0.9
            u.vx = a.vx
            if self.age > 25:
                a.vy = -0.09
            if a.y <= u.y + u.h - 2:
                a.hidden, a.vy = True, 0.0
                self.state, self.age = "in", 0
        elif s == "in":
            a.vx = u.vx = 0.0
            if self.drop and self.age > 50:
                a.hidden, a.y, a.vy = False, u.y + u.h - 1, 0.14
                self.state, self.age = "drop", 0
            elif not self.drop and self.age > 20:
                a.dead = True
                self.state, self.age = "zip", 0
        elif s == "drop":
            if a.y >= self.y0:
                a.y, a.vy, a.vx, a.wave = self.y0, 0.0, self.d * 0.06, 140
                sc.fx.append(Text(a.cx, a.y - 1, "!", (1.0, 0.9, 0.4), 50, -0.04))
                self.state, self.age = "zip", 0
        elif s == "zip" and self.age > 15:
            u.vx = _clamp(u.vx + self.zd * 0.07, -2.6, 2.6)
            u.vy = -0.03

    def under(self, put, t):
        s, a = self.state, self.age
        if not (s == "beam" and a > 4 or s == "in" and a < 12 or s == "drop"):
            return
        u, x = self.u, self.u.cx
        y0, y1 = int(round(u.y)) + u.h, int(round(self.y0)) + self.a.h
        for k, y in enumerate(range(y0, y1)):
            hw = 2 + k * 0.7
            b = 0.6 + 0.25 * math.sin(t * 0.5 + k)
            c = rgb(b, b, 0.35 * b)
            put(int(round(x - hw)), y, "/", c)
            put(int(round(x + hw)), y, "\\", c)
            dim = rgb(0.45 * b, 0.45 * b, 0.15 * b)
            for i in range(int(-hw) + 1, int(hw)):
                if (i + k + t // 2) % 4 == 0:
                    put(int(x) + i, y, ".", dim)


